﻿@{
ViewData["Title"] = "Bảng giá Café";
}

<main class="pricing-container">
    <h2 class="pricing-header">Lựa chọn gói phù hợp cho quán của bạn</h2>

    <div class="pricing-wrapper">
        <!-- Gói cơ bản -->
        <div class="pricing-box">
            <h3 class="plan-title">Gói Cơ bản</h3>
            <p class="plan-price free">Miễn phí</p>
            <ul class="plan-features">
                <li>Quản lý đơn hàng cơ bản</li>
                <li>Báo cáo doanh thu hàng ngày</li>
                <li>1 chi nhánh, không giới hạn nhân viên</li>
            </ul>
            <button class="plan-btn">Dùng miễn phí</button>
        </div>

        <!-- Gói tiêu chuẩn -->
        <div class="pricing-box featured">
            <div class="ribbon">Phổ biến nhất</div>
            <h3 class="plan-title">Gói Tiêu chuẩn</h3>
            <p class="plan-price">199.000đ / tháng</p>
            <ul class="plan-features">
                <li>Không giới hạn chi nhánh</li>
                <li>Dashboard theo ngày, tuần, tháng</li>
                <li>Quản lý menu, nhân viên, khách hàng</li>
                <li>Cập nhật tính năng tự động</li>
            </ul>
            <button class="plan-btn active">Dùng thử miễn phí</button>
        </div>

        <!-- Gói Nâng cao -->
        <div class="pricing-box">
            <h3 class="plan-title">Gói Nâng cao</h3>
            <p class="plan-price">3.900.000đ / 2 năm</p>
            <ul class="plan-features">
                <li>Không giới hạn tính năng</li>
                <li>Hỗ trợ kỹ thuật ưu tiên</li>
                <li>Tích hợp API mở rộng</li>
            </ul>
            <button class="plan-btn">Dùng thử miễn phí</button>
        </div>
    </div>
</main>