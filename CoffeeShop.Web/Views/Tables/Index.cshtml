@model IEnumerable<CoffeeShop.Domain.Entities.CafeTable>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Tables";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="mb-1">Tables Management</h2>
			<p class="text-muted mb-0">Manage cafe tables and QR codes</p>
		</div>
		<a class="btn btn-primary" asp-action="Create" asp-route-branchId="@ViewBag.BranchId">
			<i class="fas fa-plus me-1"></i> Add Table
		</a>
	</div>

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="fas fa-check-circle me-2"></i>@TempData["Success"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	@if (Model.Any())
	{
		<div class="row g-4">
			@foreach (var t in Model)
			{
				<div class="col-md-6 col-lg-4">
					<div class="card shadow-sm h-100 border-0">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-start mb-3">
								<div>
									<h5 class="card-title mb-1">
										<i class="fas fa-table text-primary me-2"></i>Table #@t.TableNumber
									</h5>
									@if (t.IsActive)
									{
										<span class="badge bg-success">
											<i class="fas fa-check-circle me-1"></i>Active
										</span>
									}
									else
									{
										<span class="badge bg-secondary">
											<i class="fas fa-times-circle me-1"></i>Inactive
										</span>
									}
								</div>
								<div class="dropdown">
									<button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
										<i class="fas fa-ellipsis-v"></i>
									</button>
									<ul class="dropdown-menu dropdown-menu-end">
										<li>
											<form method="post" asp-action="GenerateQr" class="d-inline">
												<input type="hidden" name="branchId" value="@ViewBag.BranchId" />
												<input type="hidden" name="tableId" value="@t.TableId" />
												<button type="submit" class="dropdown-item" title="Generate QR">
													<i class="fas fa-qrcode me-2"></i> Generate QR
												</button>
											</form>
										</li>
										<li><hr class="dropdown-divider" /></li>
										<li>
											<form method="post" asp-action="Delete" class="d-inline" 
												  onsubmit="return confirm('Are you sure you want to delete table @t.TableNumber?')">
												<input type="hidden" name="tableId" value="@t.TableId" />
												<button type="submit" class="dropdown-item text-danger">
													<i class="fas fa-trash me-2"></i> Delete Table
												</button>
											</form>
										</li>
									</ul>
								</div>
							</div>

							<div class="text-center mb-3">
								@if (!string.IsNullOrEmpty(t.QRCode))   
								{
									<div class="bg-light p-3 rounded">
										<img src="@Url.Action("QrCode", new { tableId = t.TableId })" 
											 alt="QR Code" 
											 width="120" 
											 height="120" 
											 class="img-fluid" />
									</div>
									<small class="text-muted">
										<i class="fas fa-check-circle text-success me-1"></i>QR Code Generated
									</small>
								}
								else
								{
									<div class="bg-light p-4 rounded">
										<i class="fas fa-qrcode fa-4x text-muted"></i>
									</div>
									<small class="text-muted">No QR Code Yet</small>
								}
							</div>

							@if (!string.IsNullOrEmpty(t.QRCode))
							{
								<div class="d-grid">
									<form method="post" asp-action="GenerateQr" class="d-inline">
										<input type="hidden" name="branchId" value="@ViewBag.BranchId" />
										<input type="hidden" name="tableId" value="@t.TableId" />
										<button type="submit" class="btn btn-outline-primary btn-sm w-100">
											<i class="fas fa-sync-alt me-1"></i> Regenerate QR
										</button>
									</form>
								</div>
							}
						</div>
					</div>
				</div>
			}
		</div>
	}
	else
	{
		<div class="card shadow-sm border-0">
			<div class="card-body text-center py-5">
				<i class="fas fa-table fa-4x text-muted mb-3"></i>
				<h5>No tables yet</h5>
				<p class="text-muted mb-4">Create tables for your branch to get started.</p>
				<a class="btn btn-primary" asp-action="Create" asp-route-branchId="@ViewBag.BranchId">
					<i class="fas fa-plus me-1"></i> Create Your First Table
				</a>
			</div>
		</div>
	}
</div>


