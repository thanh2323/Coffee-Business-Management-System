@{
	Layout = "~/Views/Shared/_Layout2.cshtml";
	ViewData["Title"] = "Tạo bàn mới";
}

<div class="container mt-4">
	<div class="mb-4">
		<h2 class="mb-1">Tạo bàn mới</h2>
		<p class="text-muted mb-0">Thêm bàn mới vào chi nhánh của bạn</p>
	</div>

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-lg-6">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<div class="mb-4">
						<h4 class="card-title mb-2">
							<i class="fas fa-table text-primary me-2"></i>Thông tin bàn
						</h4>
						<p class="text-muted small mb-0">Nhập số bàn cho chi nhánh của bạn.</p>
					</div>

					<form method="post">
						<input type="hidden" name="branchId" value="@ViewBag.BranchId" />

						<div class="mb-3">
							<label class="form-label fw-semibold" for="tableNumber">
								<i class="fas fa-hashtag me-2 text-primary"></i>Số bàn <span class="text-danger">*</span>
							</label>
							<input class="form-control form-control-lg"
								   type="number"
								   id="tableNumber"
								   name="tableNumber"
								   min="1"
								   required
								   placeholder="Ví dụ: 1, 2, 3..." />
							<small class="form-text text-muted">Nhập một số duy nhất cho bàn này (ví dụ: 1, 2, 3...).</small>
						</div>

						<hr class="my-4 bg-light" />

						<div class="d-flex justify-content-between align-items-center">
							<a class="btn btn-outline-secondary" asp-action="Index" asp-route-branchId="@ViewBag.BranchId">
								<i class="fas fa-times me-2"></i> Hủy
							</a>
							<button class="btn btn-primary btn-lg px-4" type="submit">
								<i class="fas fa-check me-2"></i> Tạo bàn
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>