@model IEnumerable<CoffeeShop.Domain.Entities.User>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                @if (ViewBag.BranchMode == true)
                {
                    <text>Nhân viên của chi nhánh #@ViewBag.BranchId</text>
                }
                else
                {
                    <text>Tất cả nhân viên</text>
                }
            </h2>
            <p class="text-muted mb-0">Quản lý danh sách nhân viên và vai trò của họ</p>
        </div>

        @if (ViewBag.BranchMode == true)
        {
            <a asp-action="Create" asp-route-branchId="@ViewBag.BranchId" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Thêm nhân viên
            </a>
        }
        else
        {
            <span class="text-muted">Chọn chi nhánh để thêm nhân viên</span>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var user in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="fas fa-user text-primary me-2"></i>@user.Username
                                    </h5>
                                    <span class="badge bg-info">@user.StaffProfile?.Position</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-envelope text-muted me-2"></i>
                                    <span class="small">@user.Email</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-store text-muted me-2"></i>
                                    <span class="small">@(user.Branch?.Name ?? $"Chi nhánh #{user.BranchId}")</span>
                                </div>
                            </div>

                            <!-- Nút hành động -->
                            <div class="mt-3 pt-3 border-top d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@user.UserId" asp-route-branchId="@ViewBag.BranchId" class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="fas fa-edit me-1"></i> Chỉnh sửa
                                </a>

                                <button type="button" class="btn btn-outline-danger btn-sm flex-fill" data-bs-toggle="modal" data-bs-target="#deleteModal-@user.UserId">
                                    <i class="fas fa-trash me-1"></i> Xóa
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="fas fa-users fa-4x text-muted mb-3"></i>
                <h5>Chưa có nhân viên nào</h5>
                <p class="text-muted mb-4">
                    @(ViewBag.BranchMode == true ? "Thêm nhân viên mới cho chi nhánh này." : "Chưa có dữ liệu nhân viên nào được ghi nhận.")
                </p>

                @if (ViewBag.BranchMode == true)
                {
                    <a asp-action="Create" asp-route-branchId="@ViewBag.BranchId" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Thêm nhân viên đầu tiên
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- Modal xác nhận xóa -->
@if (Model != null && Model.Any())
{
    @foreach (var user in Model)
    {
        <div class="modal fade" id="deleteModal-@user.UserId" tabindex="-1" aria-labelledby="deleteModalLabel-@user.UserId" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel-@user.UserId">
                            <i class="fas fa-exclamation-triangle text-danger me-2"></i>Xác nhận xóa
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        Bạn có chắc muốn xóa nhân viên <strong>@user.Username</strong> khỏi hệ thống không?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <form asp-action="Delete" method="post" style="display: inline;">
                            <input type="hidden" name="staffId" value="@user.UserId" />
                            <input type="hidden" name="branchId" value="@ViewBag.BranchId" />
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i> Xóa
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    }
}
<div class="mt-4">
    @if (User.IsInRole("Owner"))
    {
        <a href="@Url.Action("Index", "Branch")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách chi nhánh
        </a>
    }
</div>
