@model IEnumerable<CoffeeShop.Domain.Entities.User>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Staff Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                @if (ViewBag.BranchMode == true)
                {
                    <text>Staff of Branch #@ViewBag.BranchId</text>
                }
                else
                {
                    <text>All Staff Members</text>
                }
            </h2>
            <p class="text-muted mb-0">Manage staff members and their roles</p>
        </div>

        @if (ViewBag.BranchMode == true)
        {
            <!-- 🔹 Nếu đang ở trong chi nhánh -->
            <a asp-action="Create" asp-route-branchId="@ViewBag.BranchId" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> Create Staff
            </a>
        }
        else
        {
            <!-- 🔹 Nếu là Owner xem toàn bộ -->
            <span class="text-muted">Select a branch to add staff</span>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var user in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="fas fa-user text-primary me-2"></i>@user.Username
                                    </h5>
                                    <span class="badge bg-info">@user.StaffProfile?.Position</span>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a asp-action="Edit" asp-route-id="@user.UserId" asp-route-branchId="@ViewBag.BranchId" class="dropdown-item">
                                                <i class="fas fa-edit me-2"></i> Edit
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@user.UserId">
                                                <i class="fas fa-trash me-2"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-envelope text-muted me-2"></i>
                                    <span class="small">@user.Email</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-store text-muted me-2"></i>
                                    <span class="small">@(user.Branch?.Name ?? $"Branch #{user.BranchId}")</span>
                                </div>
                            </div>

                            <div class="mt-3 pt-3 border-top">
                                <a asp-action="Edit" asp-route-id="@user.UserId" asp-route-branchId="@ViewBag.BranchId" class="btn btn-outline-primary btn-sm w-100">
                                    <i class="fas fa-edit me-1"></i> Manage Staff
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="fas fa-users fa-4x text-muted mb-3"></i>
                <h5>No staff found</h5>
                <p class="text-muted mb-4">@(ViewBag.BranchMode == true ? "Add staff members to this branch." : "No staff records available.")</p>

                @if (ViewBag.BranchMode == true)
                {
                    <a asp-action="Create" asp-route-branchId="@ViewBag.BranchId" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Create Your First Staff
                    </a>
                }
            </div>
        </div>
    }
</div>

@if (Model != null && Model.Any())
{
    @foreach (var user in Model)
    {
        <div class="modal fade" id="deleteModal-@user.UserId" tabindex="-1" aria-labelledby="deleteModalLabel-@user.UserId" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel-@user.UserId">
                            <i class="fas fa-exclamation-triangle text-danger me-2"></i>Confirm Delete
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete staff member <strong>@user.Username</strong>?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form asp-action="Delete" method="post" style="display: inline;">
                            <input type="hidden" name="staffId" value="@user.UserId" />
                            <input type="hidden" name="branchId" value="@ViewBag.BranchId" />
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
