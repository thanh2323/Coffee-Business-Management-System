@model CoffeeShop.Domain.Entities.User
@using CoffeeShop.Domain.Enums
@{
	Layout = "~/Views/Shared/_Layout2.cshtml";
	ViewData["Title"] = "Sửa nhân viên";
	var positions = ViewBag.Positions as Array;
}

<div class="container mt-4">
	<div class="mb-4">
		<h2 class="mb-1">Sửa nhân viên</h2>
		<p class="text-muted mb-0">Cập nhật thông tin nhân viên</p>
	</div>

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<div class="mb-4">
						<h4 class="card-title mb-2">
							<i class="fas fa-user-edit text-primary me-2"></i>@Model.Username
						</h4>
						<p class="text-muted small mb-0">Cập nhật thông tin và cài đặt của nhân viên.</p>
					</div>

					<form asp-action="Edit" method="post">
						<input type="hidden" name="staffId" value="@Model.UserId" />
						<input type="hidden" name="branchId" value="@ViewBag.BranchId" />

						<div class="mb-3">
							<label class="form-label fw-semibold" for="username">
								<i class="fas fa-user me-2 text-primary"></i>Tên nhân viên <span class="text-danger">*</span>
							</label>
							<input type="text" name="username" id="username" class="form-control form-control-lg" value="@Model.Username" required />
							
						</div>

						<div class="mb-3">
							<label class="form-label fw-semibold" for="position">
								<i class="fas fa-briefcase me-2 text-success"></i>Vị trí <span class="text-danger">*</span>
							</label>
							<select name="position" id="position" class="form-select form-select-lg">
								@foreach (var pos in positions!)
								{
									<option value="@pos" selected="@(Model.StaffProfile?.Position.ToString() == pos.ToString())">@pos</option>
								}
							</select>
							<small class="form-text text-muted">Chọn vai trò của nhân viên.</small>
						</div>

						<hr class="my-4 bg-light" />

						<div class="d-flex justify-content-between align-items-center">
							<a asp-action="Index" asp-route-branchId="@ViewBag.BranchId" class="btn btn-outline-secondary">
								<i class="fas fa-times me-2"></i> Hủy
							</a>
							<button type="submit" class="btn btn-primary btn-lg px-4">
								<i class="fas fa-check me-2"></i> Cập nhật nhân viên
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>