@using CoffeeShop.Domain.Entities
@model CoffeeShop.Domain.Entities.Business
@{
	Layout = "~/Views/Shared/_Layout2.cshtml";
	ViewData["Title"] = "My Business";
	var branches = ViewBag.Branches as IEnumerable<Branch> ?? new List<Branch>();
}

<div class="container mt-4">
	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger">@TempData["Error"]</div>
	}
	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success">@TempData["Success"]</div>
	}
</div>

<div class="card shadow-sm">
	<div class="card-body">
		<h3 class="mb-4">@Model.Name</h3>

		<div class="row mb-3">
			<div class="col-md-6">
				<p><strong>Business ID:</strong> @Model.BusinessId</p>
				<p><strong>Phone:</strong> @(Model.Phone ?? "-")</p>
				<p><strong>Monthly Fee:</strong> @Model.MonthlyFee.ToString("N0") VND</p>
			</div>
			<div class="col-md-6">
				<p>
					<strong>Status:</strong>
					<span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
						@(Model.IsActive ? "Active" : "Inactive")
					</span>
				</p>
				<p><strong>Subscription End:</strong> @(Model.SubscriptionEndDate?.ToString("yyyy-MM-dd") ?? "-")</p>
				<p><strong>Payment Reference:</strong> @(Model.PaymentReference ?? "-")</p>
			</div>
		</div>

		@if (!string.IsNullOrEmpty(Model.Address))
		{
			<p><strong>Address:</strong> @Model.Address</p>
		}

		@if (!Model.IsActive)
		{
			<div class="alert alert-warning mt-3">
				<strong>Payment Required:</strong> Please complete payment to activate your business.
			</div>
			<form method="post" asp-controller="Business" asp-action="Pay" class="mt-3">
				<input type="hidden" name="businessId" value="@Model.BusinessId" />
				<div class="input-group">
					<select name="gateway" class="form-select w-auto">
						<option value="VNPay">VNPay</option>
						<option value="MoMo">MoMo</option>
					</select>
					<button type="submit" class="btn btn-success">Pay Now</button>
				</div>
			</form>
		}

		<hr class="my-4" />

		<h5 class="mb-3">Business Statistics</h5>
		<div class="row">
			<div class="col-md-4">
				<div class="card bg-light">
					<div class="card-body text-center">
						<h4 class="text-primary">@ViewBag.BranchCount</h4>
						<p class="mb-0">Total Branches</p>
					</div>
				</div>
			</div>
		</div>

		@if (branches.Any())
		{
			<div class="mt-4">
				<h5 class="mb-3">Branches</h5>
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Branch Name</th>
								<th>Address</th>
								<th>Opening Hours</th>
								<th>Created Date</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var branch in branches)
							{
								<tr>
									<td>@branch.Name</td>
									<td>@(branch.Address ?? "-")</td>
									<td>@branch.OpenTime.ToString(@"hh\:mm") - @branch.CloseTime.ToString(@"hh\:mm")</td>
									<td>@branch.CreatedAt.ToString("yyyy-MM-dd")</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
		else
		{
			<div class="alert alert-info mt-3">
				No branches created yet. Create your first branch to get started.
			</div>
		}
	</div>
</div>

<div class="mt-3">
	<a class="btn btn-secondary" href="/">Back to Home</a>
</div>


