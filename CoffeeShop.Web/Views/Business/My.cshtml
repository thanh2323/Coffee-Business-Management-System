@model CoffeeShop.Domain.Entities.Business

<table class="table table-bordered align-middle mt-3">
    <tr>
        <th>Tên doanh nghiệp</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Địa chỉ</th>
        <td>@Model.Address</td>
    </tr>
    <tr>
        <th>Số điện thoại</th>
        <td>@Model.Phone</td>
    </tr>
    <tr>
        <th>Phí hàng tháng</th>
        <td>@Model.MonthlyFee.ToString("N0") đ</td>
    </tr>
    <tr>
        <th>Trạng thái</th>
        <td>
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Đang hoạt động</span>
            }
            else
            {
                <span class="badge bg-secondary">Chưa kích hoạt</span>
            }
        </td>
    </tr>
</table>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.BusinessId" class="btn btn-outline-primary">
        <i class="bi bi-pencil"></i> Chỉnh sửa
    </a>
    <a asp-action="Success" asp-route-id="@Model.BusinessId" class="btn btn-outline-success">
        <i class="bi bi-credit-card"></i> Thanh toán
    </a>
</div>
