@{
    var id = ViewBag.BusinessId;
}

<div class="text-center py-4">
    <i class="bi bi-check-circle text-success display-3"></i>
    <h4 class="mt-3">Tạo doanh nghiệp thành công!</h4>
    <p>Vui lòng hoàn tất thanh toán để kích hoạt doanh nghiệp của bạn.</p>

    <form asp-action="Pay" method="post" class="d-inline">
        <input type="hidden" name="businessId" value="@id" />
        <select name="gateway" class="form-select d-inline w-auto">
            <option value="VNPay">VNPay</option>
            <option value="PayPal">PayPal</option>
        </select>
        <button type="submit" class="btn btn-success ms-2">
            <i class="bi bi-credit-card"></i> Thanh toán
        </button>
    </form>
</div>
