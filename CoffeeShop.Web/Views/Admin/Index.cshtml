@model IEnumerable<CoffeeShop.Domain.Entities.Business>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Các doanh nghiệp";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-1">Quản lý Doanh nghiệp</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã DN</th>
                            <th>Tên</th>
                            <th>Trạng thái</th>
                            <th>Ngày hết hạn</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td>#@b.BusinessId</td>
                                <td><strong>@b.Name</strong></td>
                                <td>
                                    <span class="badge bg-@(b.IsActive ? "success" : "secondary")">
                                        @(b.IsActive ? "Đang hoạt động" : "Ngừng")
                                    </span>
                                </td>
                                <td>@(b.SubscriptionEndDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>
                                    @if (!b.IsActive)
                                    {
                                        <form method="post" asp-action="Activate" asp-controller="Admin" class="d-inline">
                                            <input type="hidden" name="id" value="@b.BusinessId" />
                                            <button class="btn btn-sm btn-success" type="submit">Kích hoạt</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="Deactivate" asp-controller="Admin" class="d-inline">
                                            <input type="hidden" name="id" value="@b.BusinessId" />
                                            <button class="btn btn-sm btn-warning" type="submit">Vô hiệu hóa</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>