@using CoffeeShop.Application.Interface.IService
@using CoffeeShop.Application.DTO
@using CoffeeShop.Domain.Enums
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Bảng điều khiển quản trị";

    var systemStats = ViewBag.SystemStats as AdminSystemStatsDto;
    var businessStats = ViewBag.BusinessStats as AdminBusinessStatsDto;
    var topBusinesses = ViewBag.TopBusinesses as IEnumerable<TopBusinessDto> ?? Enumerable.Empty<TopBusinessDto>();
    var expiringBusinesses = ViewBag.ExpiringBusinesses as IEnumerable<ExpiringBusinessDto> ?? Enumerable.Empty<ExpiringBusinessDto>();
    var recentBusinesses = ViewBag.RecentBusinesses as IEnumerable<CoffeeShop.Domain.Entities.Business> ?? Enumerable.Empty<CoffeeShop.Domain.Entities.Business>();
    var revenueTimeSeries = ViewBag.RevenueTimeSeries as IEnumerable<RevenueTimeSeriesDto> ?? Enumerable.Empty<RevenueTimeSeriesDto>();
    var ordersByStatus = ViewBag.OrdersByStatus as Dictionary<OrderStatus, int> ?? new Dictionary<OrderStatus, int>();
    var selectedPeriod = ViewBag.SelectedPeriod as string ?? "today";
}

<div class="container mt-4">
    <!-- Header with Filters -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Bảng điều khiển quản trị</h2>
            <p class="text-muted mb-0">Thống kê và phân tích toàn hệ thống</p>
        </div>
        <form method="get" class="d-flex gap-2">
            <select name="period" class="form-select" onchange="this.form.submit()">
                <option value="today" selected="@(selectedPeriod == "today")">Hôm nay</option>
                <option value="week" selected="@(selectedPeriod == "week")">7 ngày qua</option>
                <option value="month" selected="@(selectedPeriod == "month")">30 ngày qua</option>
                <option value="quarter" selected="@(selectedPeriod == "quarter")">Quý gần nhất</option>
                <option value="year" selected="@(selectedPeriod == "year")">Năm nay</option>
            </select>
        </form>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Tổng quan -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">Tổng số doanh nghiệp</h6>
                            <h3 class="mb-1">@(systemStats?.TotalBusinesses ?? 0)</h3>
                            <small class="text-muted">
                                Hoạt động: <span class="text-success">@(systemStats?.ActiveBusinesses ?? 0)</span> |
                                Ngừng: <span class="text-danger">@(systemStats?.InactiveBusinesses ?? 0)</span>
                            </small>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="fas fa-building fa-2x text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">Doanh thu hôm nay</h6>
                            <h3 class="mb-1">@(systemStats?.TodayRevenue.ToString("N0") ?? "0") ₫</h3>
                            <small class="text-muted">Tổng cộng: @((systemStats?.TotalRevenue ?? 0).ToString("N0")) ₫</small>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="fas fa-dollar-sign fa-2x text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">Tổng đơn hàng</h6>
                            <h3 class="mb-1">@(systemStats?.TodayOrders ?? 0)</h3>
                            <small class="text-muted">Tổng cộng: @(systemStats?.TotalOrders ?? 0) đơn</small>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="fas fa-shopping-cart fa-2x text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-2">Người dùng hệ thống</h6>
                            <h3 class="mb-1">@(systemStats?.TotalUsers ?? 0)</h3>
                            <small class="text-muted">@(systemStats?.TotalBranches ?? 0) chi nhánh</small>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="fas fa-users fa-2x text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê bổ sung -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Doanh nghiệp mới trong tháng</h6>
                    <h3 class="mb-0 text-primary">@(businessStats?.NewBusinessesThisMonth ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Gói sắp hết hạn</h6>
                    <h3 class="mb-0 @(systemStats?.ExpiringSubscriptions > 0 ? "text-danger" : "text-success")">
                        @(systemStats?.ExpiringSubscriptions ?? 0)
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-chart-area me-2 text-primary"></i>Biểu đồ doanh thu hệ thống</h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2 text-success"></i>Đơn hàng theo trạng thái</h5>
                </div>
                <div class="card-body">
                    <canvas id="ordersStatusChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-trophy me-2 text-warning"></i>Doanh nghiệp hoạt động hiệu quả nhất</h5>
                </div>
                <div class="card-body">
                    @if (topBusinesses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Hạng</th>
                                        <th>Tên doanh nghiệp</th>
                                        <th class="text-end">Doanh thu</th>
                                        <th class="text-end">Đơn hàng</th>
                                        <th class="text-end">Chi nhánh</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int rank = 1;
                                    }
                                    @foreach (var business in topBusinesses)
                                    {
                                        <tr>
                                            <td><span class="badge bg-warning">#@rank</span></td>
                                            <td><strong>@business.BusinessName</strong></td>
                                            <td class="text-end">@business.Revenue.ToString("N0") ₫</td>
                                            <td class="text-end">@business.OrderCount</td>
                                            <td class="text-end">@business.BranchCount</td>
                                        </tr>
                                        rank++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Không có dữ liệu</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-clock me-2 text-danger"></i>Các gói sắp hết hạn</h5>
                </div>
                <div class="card-body">
                    @if (expiringBusinesses.Any())
                    {
                        <div class="list-group">
                            @foreach (var business in expiringBusinesses)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">@business.BusinessName</h6>
                                        <small class="text-muted">
                                            Hết hạn: @(business.SubscriptionEndDate?.ToString("dd/MM/yyyy") ?? "N/A")
                                        </small>
                                    </div>
                                    <span class="badge bg-@(business.DaysUntilExpiry <= 7 ? "danger" : business.DaysUntilExpiry <= 15 ? "warning" : "info")">
                                        Còn @business.DaysUntilExpiry ngày
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4"><i class="fas fa-check-circle text-success"></i> Không có gói nào sắp hết hạn</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Doanh nghiệp gần đây -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-building me-2 text-primary"></i>Doanh nghiệp mới nhất</h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
                </div>
                <div class="card-body">
                    @if (recentBusinesses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Tên</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày hết hạn</th>
                                        <th>Ngày tạo</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var business in recentBusinesses)
                                    {
                                        <tr>
                                            <td>#@business.BusinessId</td>
                                            <td><strong>@business.Name</strong></td>
                                            <td>
                                                <span class="badge bg-@(business.IsActive ? "success" : "secondary")">
                                                    @(business.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                                                </span>
                                            </td>
                                            <td>@(business.SubscriptionEndDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td>@business.CreatedAt.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (!business.IsActive)
                                                {
                                                    <form method="post" asp-action="Activate" class="d-inline">
                                                        <input type="hidden" name="id" value="@business.BusinessId" />
                                                        <button class="btn btn-sm btn-success" type="submit">Kích hoạt</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form method="post" asp-action="Deactivate" class="d-inline">
                                                        <input type="hidden" name="id" value="@business.BusinessId" />
                                                        <button class="btn btn-sm btn-warning" type="submit">Tạm ngừng</button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Không có doanh nghiệp nào gần đây</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const revenueCtx = document.getElementById('revenueChart').getContext('2d');
    const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                revenueTimeSeries.Select(ts => new { Date = ts.Date.ToString("dd/MM"), Revenue = ts.Revenue })
        ));

    new Chart(revenueCtx, {
        type: 'line',
        data: {
            labels: revenueData.map(d => d.Date),
            datasets: [{
                label: 'Doanh thu (₫)',
                data: revenueData.map(d => d.Revenue),
                borderColor: 'rgb(75, 192, 192)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return value.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            }
        }
    });

    const ordersStatusCtx = document.getElementById('ordersStatusChart').getContext('2d');
    const ordersStatusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                ordersByStatus.Select(kvp => new { Key = kvp.Key.ToString(), Value = kvp.Value })
        ));

    new Chart(ordersStatusCtx, {
        type: 'doughnut',
        data: {
            labels: ordersStatusData.map(d => d.Key),
            datasets: [{
                data: ordersStatusData.map(d => d.Value),
                backgroundColor: [
                    'rgba(255, 99, 132, 0.8)',
                    'rgba(54, 162, 235, 0.8)',
                    'rgba(255, 206, 86, 0.8)',
                    'rgba(75, 192, 192, 0.8)',
                    'rgba(153, 102, 255, 0.8)',
                    'rgba(255, 159, 64, 0.8)'
                ],
                borderWidth: 2,
                borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    });
</script>
