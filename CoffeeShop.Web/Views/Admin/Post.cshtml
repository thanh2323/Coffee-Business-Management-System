@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Quản lý bài đăng - Café Dashboard";
}

<div class="container-fluid px-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-semibold text-dark">📰 Quản lý bài đăng</h4>
        <button class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Viết bài mới
        </button>
    </div>

    <!-- Thanh tìm kiếm -->
    <div class="card p-3 mb-4 border-0 shadow-sm">
        <div class="row g-2">
            <div class="col-md-6">
                <input type="text" class="form-control" placeholder="🔍 Tìm bài đăng..." />
            </div>
            <div class="col-md-3">
                <select class="form-select">
                    <option>Tất cả trạng thái</option>
                    <option>Đã xuất bản</option>
                    <option>Bản nháp</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-secondary w-100">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
            </div>
        </div>
    </div>

    <!-- Danh sách bài đăng -->
    <div class="row g-3">
        <!-- Card bài đăng -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <img src="https://images.unsplash.com/photo-1556910103-1c27b8f85e25?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" alt="Cà phê sáng" style="height: 160px; object-fit: cover;">
                <div class="card-body">
                    <h6 class="fw-semibold text-dark">Khuyến mãi mùa thu - Giảm 20% tất cả đồ uống</h6>
                    <p class="text-muted small">Ngày đăng: 20/10/2025</p>
                    <p class="text-secondary small">Cùng thưởng thức hương vị mùa thu cùng Café...</p>
                </div>
                <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center">
                    <span class="badge bg-success">Đã xuất bản</span>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <img src="https://images.unsplash.com/photo-1586773860418-d37222d8fce3?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" alt="Cà phê đá" style="height: 160px; object-fit: cover;">
                <div class="card-body">
                    <h6 class="fw-semibold text-dark">Bài viết giới thiệu menu mới tháng 11</h6>
                    <p class="text-muted small">Ngày đăng: 01/11/2025</p>
                    <p class="text-secondary small">Menu mới với nhiều món đồ uống đặc trưng hấp dẫn...</p>
                </div>
                <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center">
                    <span class="badge bg-warning text-dark">Bản nháp</span>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <img src="https://images.unsplash.com/photo-1520072959219-c595dc870360?auto=format&fit=crop&w=800&q=80"
                     class="card-img-top" alt="Latte" style="height: 160px; object-fit: cover;">
                <div class="card-body">
                    <h6 class="fw-semibold text-dark">Workshop pha cà phê dành cho người mới</h6>
                    <p class="text-muted small">Ngày đăng: 25/09/2025</p>
                    <p class="text-secondary small">Khám phá kỹ thuật pha cà phê và bí quyết barista...</p>
                </div>
                <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center">
                    <span class="badge bg-success">Đã xuất bản</span>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    h6 {
        font-size: 15px;
    }

    .btn-primary {
        background-color: #007AFF;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0066d6;
        }
</style>
