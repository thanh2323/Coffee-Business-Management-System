@using System.Linq
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Tạo đơn hàng";
    var branchId = ViewBag.BranchId;
    var menuItems = ViewBag.MenuItems as List<CoffeeShop.Domain.Entities.MenuItem>;
    var categories = (menuItems ?? new List<CoffeeShop.Domain.Entities.MenuItem>())
                                .Select(m => m.Category)
                                .Where(c => !string.IsNullOrEmpty(c))
                                .Distinct()
                                .OrderBy(c => c);
}

<style>
    /* CSS Tùy chỉnh để giống trang Menu */
    .menu-item-card {
        border: none;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.2s ease;
    }

        .menu-item-card:hover {
            transform: translateY(-4px);
        }

        .menu-item-card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }

    .filter-buttons .btn-group {
        flex-wrap: wrap; /* Cho phép các nút xuống dòng trên di động */
    }

    /* Đảm bảo cột tóm tắt đơn hàng cuộn độc lập */
    .order-summary-container {
        position: sticky;
        top: 20px; /* Khoảng cách từ lề trên */
    }

    .summary-table-container {
        max-height: 400px;
        overflow-y: auto;
    }

    .menu-items-container {
        max-height: 80vh; /* Giới hạn chiều cao và cho phép cuộn */
        overflow-y: auto;
    }

</style>

<div class="container-fluid">
    <h2 class="mb-4">Tạo đơn hàng mới</h2>

    <div class="row">
        <div class="col-lg-4 col-md-12 mb-3">
            <div class="order-summary-container">
                <div class="card mb-3 shadow-sm border-0">
                    <div class="card-header bg-primary text-white">
                        <i class="fas fa-user me-2"></i>Thông tin khách hàng
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label>Tên <span class="text-danger">*</span></label>
                            <input type="text" id="customerName" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label>Số điện thoại</label>
                            <input type="tel" id="customerPhone" class="form-control" placeholder="Không bắt buộc">
                        </div>
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isTakeAway" style="width: 3em; height: 1.5em;">
                                <label class="form-check-label ms-2" for="isTakeAway">Mang đi</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-info text-white">
                        <i class="fas fa-list-alt me-2"></i>Tóm tắt đơn hàng
                    </div>
                    <div class="card-body">
                        <div class="summary-table-container">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Món</th>
                                        <th>SL</th>
                                        <th>Thành tiền</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="orderSummary">
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">Chưa có món nào</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="fw-bold mb-0">Tổng cộng:</h4>
                            <h4 id="totalAmount" class="fw-bold text-success mb-0">0 đ</h4>
                        </div>
                        <button class="btn btn-success btn-lg w-100 mt-3" onclick="submitOrder()">
                            <i class="fas fa-check me-2"></i>Tạo đơn hàng
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-12">
            <div class="card mb-3 shadow-sm border-0 filter-buttons">
                <div class="card-body d-flex flex-wrap gap-2 align-items-center py-2">
                    <strong class="text-muted me-2">Lọc theo:</strong>
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-primary" onclick="filterCategory('all', this)">Tất cả</button>
                        @foreach (var cat in categories)
                        {
                            <button class="btn btn-outline-primary" onclick="filterCategory('@cat', this)">@cat</button>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-utensils me-2"></i>Danh sách món
                </div>
                <div class="card-body menu-items-container">
                    <div class="row">
                        @foreach (var item in menuItems)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-6 mb-3 menu-item" data-category="@item.Category">
                                <div class="card h-100 menu-item-card">
                                    <img src="@Url.Content(item.ImagePath)" alt="@item.Name" class="card-img-top" onerror="this.src='/images/no-image.png';" />
                                    <div class="card-body text-center d-flex flex-column justify-content-between">
                                        <div>
                                            <h6>@item.Name</h6>
                                            <p class="text-primary fw-bold">@item.Price.ToString("N0") đ</p>
                                        </div>
                                        <div class="mt-2">
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        onclick="updateItemQuantity(@item.MenuItemId, -1)">
                                                    −
                                                </button>
                                                <span id="qty-@item.MenuItemId" class="btn btn-outline-secondary btn-sm" style="width: 40px;">0</span>
                                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                                        onclick="updateItemQuantity(@item.MenuItemId, 1)">
                                                    +
                                                </button>
                                            </div>
                                            <button class="btn btn-sm btn-success w-100 mt-2"
                                                    onclick="addItem(@item.MenuItemId, '@item.Name', @item.Price)">
                                                <i class="fas fa-plus me-1"></i>Thêm
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const branchId = @branchId;
        let selectedItems = [];

        // Hàm lọc danh mục
        function filterCategory(category, btn) {
            const allItems = document.querySelectorAll('.menu-item');
            const buttons = document.querySelectorAll('.filter-buttons .btn-group button');

            buttons.forEach(b => {
                b.classList.remove('btn-primary');
                b.classList.add('btn-outline-primary');
            });

            btn.classList.add('btn-primary');
            btn.classList.remove('btn-outline-primary');

            allItems.forEach(item => {
                if (category === 'all' || item.dataset.category === category)
                    item.style.display = 'block';
                else
                    item.style.display = 'none';
            });
        }

        // Cập nhật số lượng trên thẻ món ăn
        function updateItemQuantity(menuItemId, change) {
            const qtyElement = document.getElementById('qty-' + menuItemId);
            let currentQty = parseInt(qtyElement.textContent) || 0;
            qtyElement.textContent = Math.max(0, currentQty + change);
        }

        // Thêm món vào mảng selectedItems
        function addItem(menuItemId, name, price) {
            const qtyElement = document.getElementById('qty-' + menuItemId);
            const quantity = parseInt(qtyElement.textContent) || 0;

            if (quantity <= 0) {
                alert('Vui lòng chọn số lượng lớn hơn 0');
                return;
            }

            const existing = selectedItems.find(i => i.menuItemId === menuItemId);
            if (existing) {
                existing.quantity += quantity;
            } else {
                selectedItems.push({ menuItemId, name, price, quantity: quantity });
            }

            // Reset số lượng trên thẻ về 0
            qtyElement.textContent = '0';

            updateSummary();
        }

        // Cập nhật số lượng từ bảng tóm tắt
        function updateQuantity(menuItemId, qty) {
            const item = selectedItems.find(i => i.menuItemId === menuItemId);
            if (item) {
                item.quantity = parseInt(qty);
                if (item.quantity <= 0) removeItem(menuItemId);
                else updateSummary();
            }
        }

        // Xóa món khỏi bảng tóm tắt
        function removeItem(menuItemId) {
            selectedItems = selectedItems.filter(i => i.menuItemId !== menuItemId);
            updateSummary();
        }

        // Vẽ lại bảng tóm tắt
        function updateSummary() {
            const tbody = $('#orderSummary');
            tbody.empty();

            if (selectedItems.length === 0) {
                tbody.append('<tr><td colspan="4" class="text-center text-muted">Chưa có món nào</td></tr>');
                $('#totalAmount').text('0 đ');
                return;
            }

            let total = 0;
            selectedItems.forEach(item => {
                const subtotal = item.price * item.quantity;
                total += subtotal;

                tbody.append(`
                    <tr>
                        <td>
                            <div classs="fw-bold">${item.name}</div>
                            <small class="text-muted">${item.price.toLocaleString('vi-VN')} đ</small>
                        </td>
                        <td>
                            <input type="number" min="1" value="${item.quantity}"
                                   onchange="updateQuantity(${item.menuItemId}, this.value)"
                                   class="form-control form-control-sm" style="width:60px;">
                        </td>
                        <td class="fw-bold">${subtotal.toLocaleString('vi-VN')} đ</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" onclick="removeItem(${item.menuItemId})">×</button>
                        </td>
                    </tr>
                `);
            });

            $('#totalAmount').text(total.toLocaleString('vi-VN') + ' đ');
        }

        // Gửi đơn hàng
        function submitOrder() {
            const customerName = $('#customerName').val().trim();
            const customerPhone = $('#customerPhone').val().trim();
            const isTakeAway = $('#isTakeAway').is(':checked');

            if (!customerName) {
                alert('Vui lòng nhập tên khách hàng');
                return;
            }

            if (selectedItems.length === 0) {
                alert('Vui lòng thêm món vào đơn hàng');
                return;
            }

            const orderData = {
                branchId: branchId,
                customerName: customerName,
                customerPhone: customerPhone || null,
                isTakeAway: isTakeAway,
                orderItems: selectedItems.map(item => ({
                    menuItemId: item.menuItemId,
                    quantity: item.quantity,
                    price: item.price,
                    subtotal: item.price * item.quantity
                }))
            };

            $.ajax({
                url: '/Order/Create',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(orderData),
                success: function(response) {
                    if (response.success) {
                        alert('Đã tạo đơn hàng!');
                        window.location.href = `/Order/Index?branchId=${branchId}`;
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('Đã xảy ra lỗi');
                }
            });
        }
    </script>
}