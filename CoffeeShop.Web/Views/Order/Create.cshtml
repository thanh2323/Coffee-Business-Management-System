@{
     Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Create Order";
    var branchId = ViewBag.BranchId;
    var menuItems = ViewBag.MenuItems as List<CoffeeShop.Domain.Entities.MenuItem>;
}

<div class="container-fluid">
    <h2>Create New Order</h2>

    <div class="row">
        <!-- Customer Info -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    Customer Info
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label>Name <span class="text-danger">*</span></label>
                        <input type="text" id="customerName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label>Phone</label>
                        <input type="tel" id="customerPhone" class="form-control" placeholder="Optional">
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isTakeAway">
                            <label class="form-check-label">Take Away</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Menu Items -->
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header bg-success text-white">Menu Items</div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var item in menuItems)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100">
                                    <img src="@Url.Content(item.ImagePath)"alt="@item.Name" class="card-img-top"style="height: 150px; object-fit: cover;" onerror="this.src='/images/no-image.png';" />
                                    <div class="card-body text-center">
                                        <h6>@item.Name</h6>
                                        <p class="text-primary fw-bold">@item.Price.ToString("N0") đ</p>
                                        <button class="btn btn-sm btn-success w-100"
                                                onclick="addItem(@item.MenuItemId, '@item.Name', @item.Price)">
                                            Add
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="card">
                <div class="card-header bg-info text-white">Order Summary</div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="orderSummary">
                            <tr>
                                <td colspan="5" class="text-center text-muted">No items</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3">Total</th>
                                <th colspan="2"><h4 id="totalAmount">0 đ</h4></th>
                            </tr>
                        </tfoot>
                    </table>
                    <button class="btn btn-success btn-lg w-100" onclick="submitOrder()">
                        Create Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const branchId = @branchId;
        let selectedItems = [];

        function addItem(menuItemId, name, price) {
            const existing = selectedItems.find(i => i.menuItemId === menuItemId);
            if (existing) {
                existing.quantity++;
            } else {
                selectedItems.push({ menuItemId, name, price, quantity: 1 });
            }
            updateSummary();
        }

        function updateQuantity(menuItemId, qty) {
            const item = selectedItems.find(i => i.menuItemId === menuItemId);
            if (item) {
                item.quantity = parseInt(qty);
                if (item.quantity <= 0) removeItem(menuItemId);
                else updateSummary();
            }
        }

        function removeItem(menuItemId) {
            selectedItems = selectedItems.filter(i => i.menuItemId !== menuItemId);
            updateSummary();
        }

        function updateSummary() {
            const tbody = $('#orderSummary');
            tbody.empty();

            if (selectedItems.length === 0) {
                tbody.append('<tr><td colspan="5" class="text-center text-muted">No items</td></tr>');
                $('#totalAmount').text('0 đ');
                return;
            }

            let total = 0;
            selectedItems.forEach(item => {
                const subtotal = item.price * item.quantity;
                total += subtotal;

                tbody.append(`
                    <tr>
                        <td>${item.name}</td>
                        <td>${item.price.toLocaleString('vi-VN')} đ</td>
                        <td>
                            <input type="number" min="1" value="${item.quantity}"
                                   onchange="updateQuantity(${item.menuItemId}, this.value)"
                                   class="form-control form-control-sm" style="width:70px;">
                        </td>
                        <td>${subtotal.toLocaleString('vi-VN')} đ</td>
                        <td>
                            <button class="btn btn-sm btn-danger" onclick="removeItem(${item.menuItemId})">×</button>
                        </td>
                    </tr>
                `);
            });

            $('#totalAmount').text(total.toLocaleString('vi-VN') + ' đ');
        }

            function submitOrder() {
                const customerName = $('#customerName').val().trim();
                const customerPhone = $('#customerPhone').val().trim();
                const isTakeAway = $('#isTakeAway').is(':checked');

                if (!customerName) {
                    alert('Enter customer name');
                    return;
                }

                if (selectedItems.length === 0) {
                    alert('Add items');
                    return;
                }

                const orderData = {
                    branchId: branchId,
                    customerName: customerName,
                    customerPhone: customerPhone || null,
                    isTakeAway: isTakeAway,
                    orderItems: selectedItems.map(item => ({
                        menuItemId: item.menuItemId,
                        quantity: item.quantity,
                        price: item.price,
                        subtotal: item.price * item.quantity
                    }))
                };

                $.ajax({
                    url: '/Order/Create',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(orderData),
                    success: function(response) {
                        if (response.success) {
                            alert('Order created!');
                            window.location.href = `/Order/Index?branchId=${branchId}`;
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('Error occurred');
                    }
                });
            }
        </script>
}   