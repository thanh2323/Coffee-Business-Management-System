@using CoffeeShop.Domain.Enums
@model IEnumerable<CoffeeShop.Domain.Entities.Order>

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý đơn hàng</h2>
        @if (ViewBag.BranchId != null)
        {
            <a asp-action="Create" asp-route-branchId="@ViewBag.BranchId" class="btn btn-primary">
                <i class="fas fa-plus"></i> Tạo đơn mới
            </a>
        }
    </div>

    <!-- Bộ lọc -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3">
                @if (ViewBag.BranchId != null)
                {
                    <input type="hidden" name="branchId" value="@ViewBag.BranchId" />
                }
                <div class="col-md-4">
                    <label>Lọc theo trạng thái</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả đơn hàng</option>
                        @foreach (var s in Enum.GetValues(typeof(OrderStatus)))
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng đơn hàng -->
    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Chi nhánh</th>
                        <th>Khách hàng</th>
                        <th>SĐT</th>
                        <th>Hình thức</th>
                        <th>Trạng thái</th>
                        <th>Tổng tiền</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr data-order-id="@order.OrderId">
                            <td><strong>#@order.OrderId</strong></td>
                            <td>@(order.Branch?.Name ?? "—")</td>
                            <td>@order.Customer.Name</td>
                            <td>@(order.Customer.Phone ?? "Không có")</td>
                            <td>
                                <span class="badge bg-@(order.IsTakeAway ? "info" : "secondary")">
                                    @(order.IsTakeAway ? "Mang đi" : "Dùng tại quán")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-@GetStatusColor(order.CurrentStatus)" id="status-@order.OrderId">
                                    @order.CurrentStatus
                                </span>
                            </td>
                            <td><strong>@order.TotalAmount.ToString("N0") đ</strong></td>
                            <td>@order.OrderDate.ToString("dd/MM HH:mm")</td>
                            <td>
                                @if (ViewBag.BranchId != null)
                                {
                                    <div class="btn-group" role="group">
                                        @if (order.CurrentStatus == OrderStatus.Pending)
                                        {
                                            <button class="btn btn-sm btn-success" onclick="updateStatus(@order.OrderId, 'Confirmed')">Xác nhận</button>
                                        }
                                        @if (order.CurrentStatus == OrderStatus.Confirmed)
                                        {
                                            <button class="btn btn-sm btn-warning" onclick="updateStatus(@order.OrderId, 'Preparing')">Đang pha chế</button>
                                        }
                                        @if (order.CurrentStatus == OrderStatus.Preparing)
                                        {
                                            <button class="btn btn-sm btn-primary" onclick="updateStatus(@order.OrderId, 'Ready')">Hoàn tất</button>
                                        }
                                        @if (order.CurrentStatus == OrderStatus.Ready)
                                        {
                                            <button class="btn btn-sm btn-success" onclick="updateStatus(@order.OrderId, 'Completed')">Hoàn thành</button>
                                        }
                                        @if (order.CurrentStatus != OrderStatus.Completed && order.CurrentStatus != OrderStatus.Cancelled)
                                        {
                                            <button class="btn btn-sm btn-danger" onclick="updateStatus(@order.OrderId, 'Cancelled')">Hủy</button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "secondary",
            OrderStatus.Confirmed => "info",
            OrderStatus.Preparing => "warning",
            OrderStatus.Ready => "primary",
            OrderStatus.Completed => "success",
            OrderStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script>
        async function updateStatus(orderId, newStatus) {
            if (!confirm(`Bạn có chắc muốn chuyển trạng thái sang "${newStatus}" không?`)) return;

            try {
                const response = await fetch('/Order/UpdateStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: new URLSearchParams({
                        orderId: orderId,
                        newStatus: newStatus
                    })
                });

                const result = await response.json();

                if (result.success) {
                    // ✅ Cập nhật badge trạng thái
                    const badge = document.getElementById(`status-${orderId}`);
                    if (badge) {
                        badge.innerText = result.newStatus;
                        badge.className = "badge bg-" + getStatusColor(result.newStatus);
                    }

                    // ✅ Cập nhật lại nhóm nút hành động
                    const row = document.querySelector(`tr[data-order-id="${orderId}"]`);
                    if (row) {
                        const actionTd = row.querySelector('td:last-child');
                        actionTd.innerHTML = renderActionButtons(orderId, result.newStatus);
                    }

                    alert('✅ ' + result.message);
                } else {
                    alert('❌ ' + result.message);
                }
            } catch (err) {
                console.error(err);
                alert('❌ Không thể cập nhật trạng thái.');
            }
        }

        function getAntiForgeryToken() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        function getStatusColor(status) {
            switch (status) {
                case 'Pending': return 'secondary';
                case 'Confirmed': return 'info';
                case 'Preparing': return 'warning';
                case 'Ready': return 'primary';
                case 'Completed': return 'success';
                case 'Cancelled': return 'danger';
                default: return 'secondary';
            }
        }

        // ✅ Sinh lại nhóm nút phù hợp theo trạng thái mới
        function renderActionButtons(orderId, status) {
            switch (status) {
                case 'Pending':
                    return `<div class="btn-group">
                                <button class="btn btn-sm btn-success" onclick="updateStatus(${orderId}, 'Confirmed')">Xác nhận</button>
                                <button class="btn btn-sm btn-danger" onclick="updateStatus(${orderId}, 'Cancelled')">Hủy</button>
                            </div>`;
                case 'Confirmed':
                    return `<div class="btn-group">
                                <button class="btn btn-sm btn-warning" onclick="updateStatus(${orderId}, 'Preparing')">Đang pha chế</button>
                                <button class="btn btn-sm btn-danger" onclick="updateStatus(${orderId}, 'Cancelled')">Hủy</button>
                            </div>`;
                case 'Preparing':
                    return `<div class="btn-group">
                                <button class="btn btn-sm btn-primary" onclick="updateStatus(${orderId}, 'Ready')">Hoàn tất</button>
                                <button class="btn btn-sm btn-danger" onclick="updateStatus(${orderId}, 'Cancelled')">Hủy</button>
                            </div>`;
                case 'Ready':
                    return `<div class="btn-group">
                                <button class="btn btn-sm btn-success" onclick="updateStatus(${orderId}, 'Completed')">Hoàn thành</button>
                                <button class="btn btn-sm btn-danger" onclick="updateStatus(${orderId}, 'Cancelled')">Hủy</button>
                            </div>`;
                case 'Completed':
                    return `<span class="text-success">✅ Đã hoàn thành</span>`;
                case 'Cancelled':
                    return `<span class="text-danger">❌ Đã hủy</span>`;
                default:
                    return '';
            }
        }
    </script>
}
