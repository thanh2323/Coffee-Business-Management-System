@using CoffeeShop.Domain.Enums
@model IEnumerable<CoffeeShop.Domain.Entities.Order>
@{
	Layout = "~/Views/Shared/_Layout2.cshtml";
	ViewData["Title"] = "Đơn hàng";
}

<div class="container-fluid">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Quản lý đơn hàng</h2>
		<a asp-action="Create" asp-route-branchId="@ViewBag.BranchId" class="btn btn-primary">
			<i class="fas fa-plus"></i> Tạo đơn mới
		</a>
	</div>

	<!-- Filter -->
	<div class="card mb-3">
		<div class="card-body">
			<form method="get" class="row g-3">
				<input type="hidden" name="branchId" value="@ViewBag.BranchId" />
				<div class="col-md-4">
					<label>Lọc theo trạng thái</label>
					<select name="status" class="form-select" onchange="this.form.submit()">
						<option value="">Tất cả đơn hàng</option>
						<option value="Pending">Chờ xác nhận</option>
						<option value="Confirmed">Đã xác nhận</option>
						<option value="Preparing">Đang chuẩn bị</option>
						<option value="Ready">Sẵn sàng</option>
						<option value="Completed">Hoàn thành</option>
						<option value="Cancelled">Đã hủy</option>
					</select>
				</div>
			</form>
		</div>
	</div>

	<!-- Orders Table -->
	<div class="card">
		<div class="card-body">
			<table class="table table-hover" id="ordersTable">
				<thead>
					<tr>
						<th>Mã đơn</th>
						<th>Khách hàng</th>
						<th>Điện thoại</th>
						<th>Loại</th>
						<th>Trạng thái</th>
						<th>Tổng cộng</th>
						<th>Ngày</th>
						<th>Hành động</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var order in Model)
					{
						<tr data-order-id="@order.OrderId">
							<td><strong>#@order.OrderId</strong></td>
							<td>@order.Customer.Name</td>
							<td>@(order.Customer.Phone ?? "Không có")</td>
							<td>
								<span class="badge bg-@(order.IsTakeAway ? "info" : "secondary")">
									@(order.IsTakeAway ? "Mang đi" : "Tại quán")
								</span>
							</td>
							<td>
								<span class="badge bg-@GetStatusColor(order.CurrentStatus)" id="status-@order.OrderId">
									@TranslateStatus(order.CurrentStatus)
								</span>
							</td>
							<td><strong>@order.TotalAmount.ToString("N0") VNĐ</strong></td>
							<td>@order.OrderDate.ToString("dd/MM HH:mm")</td>
							<td>
								<div class="btn-group" role="group">
									@if (order.CurrentStatus == OrderStatus.Pending)
									{
										<button class="btn btn-sm btn-success" onclick="updateStatus(@order.OrderId, 'Confirmed')">
											Xác nhận
										</button>
									}
									@if (order.CurrentStatus == OrderStatus.Confirmed)
									{
										<button class="btn btn-sm btn-warning" onclick="updateStatus(@order.OrderId, 'Preparing')">
											Chuẩn bị
										</button>
									}
									@if (order.CurrentStatus == OrderStatus.Preparing)
									{
										<button class="btn btn-sm btn-primary" onclick="updateStatus(@order.OrderId, 'Ready')">
											Sẵn sàng
										</button>
									}
									@if (order.CurrentStatus == OrderStatus.Ready)
									{
										<button class="btn btn-sm btn-success" onclick="updateStatus(@order.OrderId, 'Completed')">
											Hoàn thành
										</button>
									}
									@if (order.CurrentStatus != OrderStatus.Completed && order.CurrentStatus != OrderStatus.Cancelled)
									{
										<button class="btn btn-sm btn-danger" onclick="updateStatus(@order.OrderId, 'Cancelled')">
											Hủy
										</button>
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
	<script>
		const branchId = @ViewBag.BranchId;

		// SignalR Connection
		const connection = new signalR.HubConnectionBuilder()
			.withUrl("/orderHub")
			.withAutomaticReconnect()
			.build();

		connection.on("NewOrderReceived", function (order) {
			console.log("Đã nhận đơn hàng mới:", order);
			// Tải lại trang để đảm bảo tính nhất quán của dữ liệu
			location.reload();
		});

		connection.on("OrderStatusChanged", function (data) {
			console.log("Trạng thái đơn hàng đã thay đổi:", data);
			updateOrderStatusUI(data.orderId, data.newStatus);
			updateOrderButtons(data.orderId, data.newStatus);
		});

		connection.start()
			.then(() => {
				console.log("SignalR đã kết nối");
				return connection.invoke("JoinBranchGroup", branchId);
			})
			.catch(err => console.error("Lỗi SignalR:", err));

		// Hàm dịch trạng thái sang tiếng Việt
		function translateStatus(status) {
			const translations = {
				'Pending': 'Chờ xác nhận',
				'Confirmed': 'Đã xác nhận',
				'Preparing': 'Đang chuẩn bị',
				'Ready': 'Sẵn sàng',
				'Completed': 'Hoàn thành',
				'Cancelled': 'Đã hủy'
			};
			return translations[status] || status;
		}

		// Update order status
		function updateStatus(orderId, newStatus) {
			if (!confirm(`Đổi trạng thái sang "${translateStatus(newStatus)}"?`)) return;

			fetch('/Order/UpdateStatus', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/x-www-form-urlencoded',
				},
				body: new URLSearchParams({
					orderId: orderId,
					newStatus: newStatus
				})
			})
			.then(response => response.json())
			.then(data => {
				if (data.success) {
					// UI sẽ update qua SignalR
				} else {
					alert(data.message);
				}
			})
			.catch(error => alert('Lỗi: ' + error));
		}

		function updateOrderStatusUI(orderId, newStatus) {
			const statusBadge = document.getElementById(`status-${orderId}`);
			if (statusBadge) {
				statusBadge.textContent = translateStatus(newStatus); // Dịch trạng thái
				statusBadge.className = `badge bg-${getStatusColor(newStatus)}`;
			}
		}

		function updateOrderButtons(orderId, newStatus) {
			const row = document.querySelector(`tr[data-order-id="${orderId}"]`);
			if (!row) return;

			const actionsCell = row.querySelector('td:last-child .btn-group');
			if (!actionsCell) return;

			// Clear existing buttons
			actionsCell.innerHTML = '';

			// Add buttons based on new status
			let buttons = '';

			if (newStatus === 'Pending') {
				buttons += `<button class="btn btn-sm btn-success" onclick="updateStatus(${orderId}, 'Confirmed')">Xác nhận</button>`;
			}
			if (newStatus === 'Confirmed') {
				buttons += `<button class="btn btn-sm btn-warning" onclick="updateStatus(${orderId}, 'Preparing')">Chuẩn bị</button>`;
			}
			if (newStatus === 'Preparing') {
				buttons += `<button class="btn btn-sm btn-primary" onclick="updateStatus(${orderId}, 'Ready')">Sẵn sàng</button>`;
			}
			if (newStatus === 'Ready') {
				buttons += `<button class="btn btn-sm btn-success" onclick="updateStatus(${orderId}, 'Completed')">Hoàn thành</button>`;
			}
			if (newStatus !== 'Completed' && newStatus !== 'Cancelled') {
				buttons += `<button class="btn btn-sm btn-danger" onclick="updateStatus(${orderId}, 'Cancelled')">Hủy</button>`;
			}

			actionsCell.innerHTML = buttons;
		}

		function getStatusColor(status) {
			const colors = {
				'Pending': 'secondary',
				'Confirmed': 'info',
				'Preparing': 'warning',
				'Ready': 'primary',
				'Completed': 'success',
				'Cancelled': 'danger'
			};
			return colors[status] || 'secondary';
		}
	</script>
}

@functions {
	private string GetStatusColor(OrderStatus status)
	{
		return status switch
		{
			OrderStatus.Pending => "secondary",
			OrderStatus.Confirmed => "info",
			OrderStatus.Preparing => "warning",
			OrderStatus.Ready => "primary",
			OrderStatus.Completed => "success",
			OrderStatus.Cancelled => "danger",
			_ => "secondary"
		};
	}

	private string TranslateStatus(OrderStatus status)
	{
		return status switch
		{
			OrderStatus.Pending => "Chờ xác nhận",
			OrderStatus.Confirmed => "Đã xác nhận",
			OrderStatus.Preparing => "Đang chuẩn bị",
			OrderStatus.Ready => "Sẵn sàng",
			OrderStatus.Completed => "Hoàn thành",
			OrderStatus.Cancelled => "Đã hủy",
			_ => status.ToString()
		};
	}
}