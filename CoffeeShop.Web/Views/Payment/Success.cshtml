@model IEnumerable<CoffeeShop.Domain.Entities.TempOrderItem>
@{
    Layout = null;
    ViewData["Title"] = "Thanh toán thành công";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

    <style>
        /* BASE STYLES */
        body {
            background: #e8f5ff; /* Nền xanh pastel nhạt */
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh; /* Đảm bảo căn giữa toàn màn hình */
            margin: 0;
        }

        /* SUCCESS CARD */
        .success-card {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15); /* Shadow nổi bật */
            border: 1px solid #b7dbff;
            max-width: 450px;
            width: 90%;
        }

        h2 {
            font-size: 32px;
            font-weight: 900;
            color: #0d304a; /* Xanh đậm */
            margin-bottom: 20px;
        }

        p {
            font-size: 18px;
            color: #4a6c8e; /* Xanh xám */
            margin-bottom: 30px;
        }

        /* SUCCESS ICON */
        .success-icon {
            font-size: 60px;
            color: #5cb85c; /* Màu xanh lá cây của Bootstrap success */
            margin-bottom: 20px;
            animation: pulse 1.5s infinite;
        }

        /* BUTTON (CTA) */
        .btn-primary {
            background: #8fd1ff; /* Xanh Pastel */
            border: none;
            border-radius: 12px;
            padding: 12px 30px;
            font-weight: 800;
            font-size: 18px;
            transition: .3s;
            color: white;
        }

            .btn-primary:hover {
                background: #5ea8e0;
                transform: translateY(-2px);
            }

        /* Animation cho icon */
        @@keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1);
            }
        }

    </style>
</head>
<body>

    <div class="success-card text-center">
        <!-- Icon và tiêu đề được đưa vào card -->
        <div class="success-icon">
            <i class="fas fa-check-circle"></i>
        </div>

        <h2>Thanh toán thành công!</h2>
        <p>@ViewBag.Message</p>
        <a href="/" class="btn btn-primary mt-3">Quay về trang chủ</a>
    </div>

</body>
</html>