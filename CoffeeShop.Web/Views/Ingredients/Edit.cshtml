@model CoffeeShop.Domain.Entities.Ingredient
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Sửa nguyên liệu";
}

<div class="container mt-4">
	<div class="mb-4">
		<h2 class="mb-1">Sửa nguyên liệu</h2>
		<p class="text-muted mb-0">Cập nhật thông tin nguyên liệu</p>
	</div>

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<div class="mb-4">
						<h4 class="card-title mb-2">
							<i class="fas fa-box text-primary me-2"></i>@Model.Name
						</h4>
						<p class="text-muted small mb-0">Cập nhật thông tin và cài đặt của nguyên liệu.</p>
					</div>

					<form method="post" asp-action="Edit">
						<input type="hidden" name="branchId" value="@ViewBag.BranchId" />
						<input type="hidden" name="ingredientName" value="@ViewBag.OriginalName" />
						
						<div class="mb-3">
							<label class="form-label fw-semibold" for="name">
								<i class="fas fa-tag me-2 text-primary"></i>Tên nguyên liệu <span class="text-danger">*</span>
							</label>
							<input class="form-control form-control-lg" 
								   name="name" 
								   id="name"
								   value="@Model.Name" 
								   required 
								   placeholder="Ví dụ: Hạt cà phê, Sữa, Đường"/>
							<small class="form-text text-muted">Nhập tên của nguyên liệu.</small>
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold" for="quantity">
									<i class="fas fa-weight me-2 text-info"></i>Số lượng <span class="text-danger">*</span>
								</label>
								<input class="form-control form-control-lg" 
									   name="quantity" 
									   id="quantity"
									   type="number" 
									   step="1" 
									   min="0" 
									   value="@Model.Quantity" 
									   required />
								<small class="form-text text-muted">Số lượng tồn kho hiện tại.</small>
							</div>
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold" for="unitCost">
									<i class="fas fa-tags me-2 text-success"></i>Giá / Đơn vị (VND) <span class="text-danger">*</span>
								</label>
								<div class="input-group input-group-lg">
									<input class="form-control" 
										   name="unitCost" 
										   id="unitCost"
										   type="number" 
										   step="1000" 
										   min="0" 
										   value="@Model.UnitCost" 
										   required />
									<span class="input-group-text">VND</span>
								</div>
								<small class="form-text text-muted">Giá cho mỗi đơn vị.</small>
							</div>
						</div>

						<div class="mb-3">
							<label class="form-label fw-semibold" for="displayUnit">
								<i class="fas fa-box-open me-2 text-warning"></i>Kích thước đóng gói
							</label>
							<input class="form-control form-control-lg" 
								   name="displayUnit" 
								   id="displayUnit"
								   value="@Model.DisplayUnit" 
								   placeholder="Ví dụ: 1l, 500ml, 5kg, 10pcs" />
							<small class="form-text text-muted">
								<i class="fas fa-info-circle me-1"></i>
								Hệ thống sẽ tự động phát hiện loại đơn vị. Ví dụ: "1l" → 1000ml, "5kg" → 5000g, "10pcs" → 10pcs
							</small>
						</div>

						<hr class="my-4 bg-light" />

						<div class="d-flex justify-content-between align-items-center">
							<a class="btn btn-outline-secondary" asp-action="Index" asp-route-branchId="@ViewBag.BranchId">
								<i class="fas fa-times me-2"></i> Hủy
							</a>
							<button class="btn btn-primary btn-lg px-4" type="submit">
								<i class="fas fa-check me-2"></i> Cập nhật nguyên liệu
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>