@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Create Ingredient";
}

<div class="container mt-4">
	<div class="mb-4">
		<h2 class="mb-1">Create New Ingredient</h2>
		<p class="text-muted mb-0">Add a new ingredient to your inventory</p>
	</div>

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<div class="mb-4">
						<h4 class="card-title mb-2">
							<i class="fas fa-box text-primary me-2"></i>Ingredient Information
						</h4>
						<p class="text-muted small mb-0">Enter the details for your new ingredient.</p>
					</div>

					<form method="post" asp-action="Create">
						<input type="hidden" name="branchId" value="@ViewBag.BranchId" />
						
						<div class="mb-3">
							<label class="form-label fw-semibold" for="name">
								<i class="fas fa-tag me-2 text-primary"></i>Ingredient Name <span class="text-danger">*</span>
							</label>
							<input class="form-control form-control-lg" 
								   name="name" 
								   id="name"
								   required 
								   placeholder="e.g., Coffee Beans, Milk, Sugar"/>
							<small class="form-text text-muted">Enter the name of the ingredient.</small>
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold" for="quantity">
									<i class="fas fa-weight me-2 text-info"></i>Quantity <span class="text-danger">*</span>
								</label>
								<input class="form-control form-control-lg" 
									   name="quantity" 
									   id="quantity"
									   type="number" 
									   step="1" 
									   min="0" 
									   value="0" 
									   required />
								<small class="form-text text-muted">Current stock quantity.</small>
							</div>
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold" for="unitCost">
									<i class="fas fa-tags me-2 text-success"></i>Unit Cost (VND) <span class="text-danger">*</span>
								</label>
								<div class="input-group input-group-lg">
									<input class="form-control" 
										   name="unitCost" 
										   id="unitCost"
										   type="number" 
										   step="1" 
										   min="0" 
										   value="0" 
										   required />
									<span class="input-group-text">VND</span>
								</div>
								<small class="form-text text-muted">Cost per unit.</small>
							</div>
						</div>

						<div class="mb-3">
							<label class="form-label fw-semibold" for="displayUnit">
								<i class="fas fa-box-open me-2 text-warning"></i>Package Size
							</label>
							<input class="form-control form-control-lg" 
								   name="displayUnit" 
								   id="displayUnit"
								   placeholder="e.g., 1l, 500ml, 5kg, 10pcs" />
							<small class="form-text text-muted">
								<i class="fas fa-info-circle me-1"></i>
								System will auto-detect unit type. Examples: "1l" → 1000ml, "5kg" → 5000g, "10pcs" → 10pcs
							</small>
						</div>

						<hr class="my-4 bg-light" />

						<div class="d-flex justify-content-between align-items-center">
							<a class="btn btn-outline-secondary" asp-action="Index" asp-route-branchId="@ViewBag.BranchId">
								<i class="fas fa-times me-2"></i> Cancel
							</a>
							<button class="btn btn-primary btn-lg px-4" type="submit">
								<i class="fas fa-check me-2"></i> Create Ingredient
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>


