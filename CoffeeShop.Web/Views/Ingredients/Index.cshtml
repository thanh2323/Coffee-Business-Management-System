@model IEnumerable<CoffeeShop.Domain.Entities.Ingredient>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Quản lý nguyên liệu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Kho nguyên liệu</h2>
            <p class="text-muted mb-0">Quản lý nguyên liệu và số lượng tồn kho</p>
        </div>
        <a class="btn btn-primary" asp-action="Create" asp-route-branchId="@ViewBag.BranchId">
            <i class="fas fa-plus me-1"></i> Thêm nguyên liệu
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var i in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="fas fa-box text-primary me-2"></i>@i.Name
                                    </h5>
                                    <span class="badge bg-info">@i.BaseUnit</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Số lượng tồn:</span>
                                    <span class="fw-bold">@i.Quantity.ToString("N0")</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Đơn giá:</span>
                                    <span class="fw-bold text-success">@i.UnitCost.ToString("N0") VND</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(i.DisplayUnit))
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">Đóng gói:</span>
                                        <span class="badge bg-secondary">@i.DisplayUnit</span>
                                    </div>
                                </div>
                            }

                            <!-- Nút hành động -->
                            <div class="mt-3 pt-3 border-top d-flex gap-2">
                                <a asp-action="Edit" asp-route-branchId="@ViewBag.BranchId" asp-route-ingredientName="@i.Name" class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="fas fa-edit me-1"></i> Chỉnh sửa
                                </a>

                                <form method="post" asp-action="Delete" class="flex-fill"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa nguyên liệu @i.Name không?')">
                                    <input type="hidden" name="branchId" value="@ViewBag.BranchId" />
                                    <input type="hidden" name="ingredientName" value="@i.Name" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                        <i class="fas fa-trash me-1"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="fas fa-box fa-4x text-muted mb-3"></i>
                <h5>Chưa có nguyên liệu nào</h5>
                <p class="text-muted mb-4">Thêm nguyên liệu mới để bắt đầu quản lý kho hàng.</p>
                <a class="btn btn-primary" asp-action="Create" asp-route-branchId="@ViewBag.BranchId">
                    <i class="fas fa-plus me-1"></i> Thêm nguyên liệu đầu tiên
                </a>
            </div>
        </div>
    }
</div>

<!-- Nút quay lại chỉ cho Owner -->
<div class="mt-4">
    @if (User.IsInRole("Owner"))
    {
        <a href="@Url.Action("Index", "Branch")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách chi nhánh
        </a>
    }
</div>
