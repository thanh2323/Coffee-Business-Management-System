@model IEnumerable<CoffeeShop.Domain.Entities.Ingredient>
@{
	Layout = "~/Views/Shared/_Layout2.cshtml";
	ViewData["Title"] = "Ingredients";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="mb-1">Ingredients Inventory</h2>
			<p class="text-muted mb-0">Manage ingredients and stock levels</p>
		</div>
		<a class="btn btn-primary" asp-action="Create" asp-route-branchId="@ViewBag.BranchId">
			<i class="fas fa-plus me-1"></i> Add Ingredient
		</a>
	</div>

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="fas fa-check-circle me-2"></i>@TempData["Success"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	@if (Model.Any())
	{
		<div class="row g-4">
			@foreach (var i in Model)
			{
				<div class="col-md-6 col-lg-4">
					<div class="card shadow-sm h-100 border-0">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-start mb-3">
								<div>
									<h5 class="card-title mb-1">
										<i class="fas fa-box text-primary me-2"></i>@i.Name
									</h5>
									<span class="badge bg-info">@i.BaseUnit</span>
								</div>
								<div class="dropdown">
									<button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
										<i class="fas fa-ellipsis-v"></i>
									</button>
									<ul class="dropdown-menu dropdown-menu-end">
										<li>
											<a class="dropdown-item" asp-action="Edit" asp-route-branchId="@ViewBag.BranchId" asp-route-ingredientName="@i.Name">
												<i class="fas fa-edit me-2"></i> Edit
											</a>
										</li>
										<li><hr class="dropdown-divider" /></li>
										<li>
											<form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Delete @i.Name?')">
												<input type="hidden" name="branchId" value="@ViewBag.BranchId" />
												<input type="hidden" name="ingredientName" value="@i.Name" />
												<button type="submit" class="dropdown-item text-danger">
													<i class="fas fa-trash me-2"></i> Delete
												</button>
											</form>
										</li>
									</ul>
								</div>
							</div>

							<div class="mb-3">
								<div class="d-flex justify-content-between align-items-center">
									<span class="text-muted small">Quantity:</span>
									<span class="fw-bold">@i.Quantity.ToString("N0")</span>
								</div>
							</div>

							<div class="mb-3">
								<div class="d-flex justify-content-between align-items-center">
									<span class="text-muted small">Unit Cost:</span>
									<span class="fw-bold text-success">@i.UnitCost.ToString("N0") VND</span>
								</div>
							</div>

							@if (!string.IsNullOrEmpty(i.DisplayUnit))
							{
								<div class="mb-3">
									<div class="d-flex justify-content-between align-items-center">
										<span class="text-muted small">Package:</span>
										<span class="badge bg-secondary">@i.DisplayUnit</span>
									</div>
								</div>
							}

							<div class="mt-3 pt-3 border-top">
								<a asp-action="Edit" asp-route-branchId="@ViewBag.BranchId" asp-route-ingredientName="@i.Name" class="btn btn-outline-primary btn-sm w-100">
									<i class="fas fa-edit me-1"></i> Manage Ingredient
								</a>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
	else
	{
		<div class="card shadow-sm border-0">
			<div class="card-body text-center py-5">
				<i class="fas fa-box fa-4x text-muted mb-3"></i>
				<h5>No ingredients yet</h5>
				<p class="text-muted mb-4">Add ingredients to your inventory to get started.</p>
				<a class="btn btn-primary" asp-action="Create" asp-route-branchId="@ViewBag.BranchId">
					<i class="fas fa-plus me-1"></i> Create Your First Ingredient
				</a>
			</div>
		</div>
	}
</div>


