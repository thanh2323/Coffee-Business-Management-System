@model IEnumerable<CoffeeShop.Domain.Entities.MenuItem>
@{
    Layout = null; // Disable default layout
    ViewData["Title"] = "Thực đơn";
    var table = ViewBag.Table as CoffeeShop.Domain.Entities.CafeTable;
    var branch = ViewBag.Branch as CoffeeShop.Domain.Entities.Branch;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        body {
            background-color: #f9f9f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .menu-header {
            background-color: #ffffff;
            border-bottom: 1px solid #ddd;
            padding: 15px 20px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .menu-header h2 {
                margin: 0;
                font-weight: 600;
                font-size: 1.5rem;
            }

        .cart-btn {
            position: relative;
        }

        .badge {
            font-size: 0.8rem;
            margin-bottom: 10px;
        }

        .card {
            border: none;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.2s ease;
        }

            .card:hover {
                transform: translateY(-4px);
            }

        /* (MỚI) CSS cho hình ảnh placeholder */
        .placeholder-img {
            width: 100%;
            height: 180px;
            background-color: #e9ecef; /* Màu nền xám nhạt */
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .placeholder-img i {
            font-size: 4rem;
            color: #adb5bd; /* Màu icon xám */
        }

            .card img {
                width: 100%;
                height: 180px;
                object-fit: cover;
            }

        .card-body {
            padding: 15px;
        }

        .btn-group .btn {
            min-width: 35px;
        }


        .menu-header h2 {
            margin-bottom: 10px;
        }

        .filter-container {
            padding: 10px 20px;
            background-color: #fff;
            border-bottom: 1px solid #ddd;
        }
        
    </style>
</head>

<body>

    <div class="menu-header d-flex justify-content-between align-items-center">
        <h2>@branch?.Name - Bàn @table?.TableNumber</h2>
        <a href="@Url.Action("Cart", new { tableId = table?.TableId, branchId = branch?.BranchId })"
           class="btn btn-primary cart-btn">
            <i class="fas fa-shopping-cart me-1"></i>
            Giỏ hàng
            <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                0
            </span>
        </a>
    </div>

    <div class="container mt-3 filter-container">
        <div class="btn-group flex-wrap" role="group">
            <button class="btn btn-outline-primary active" onclick="filterCategory('all', event)">Tất cả</button>
            @foreach (var cat in Model.Select(m => m.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct())
            {
                <button class="btn btn-outline-primary" onclick="filterCategory('@cat', event)">@cat</button>
            }
        </div>
    </div>


    <div class="container py-4">
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-4 col-lg-3 menu-item" data-category="@item.Category">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img loading="lazy" src="@Url.Content(item.ImagePath)" alt="@item.Name"
                                 onerror="this.outerHTML = '<div class=\'placeholder-img\'><i class=\'fas fa-mug-hot\'></i></div>';" />
                        }
                        else
                        {
                            <div class="placeholder-img">
                                <i class="fas fa-mug-hot"></i>
                            </div>
                        }
                        
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="card-title fw-semibold">@item.Name</h6>
                                <p class="text-muted mb-2">@item.Price.ToString("N0") ₫</p>
                                @if (!string.IsNullOrEmpty(item.Category))
                                {
                                    <span class="badge bg-secondary">@item.Category</span>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            onclick="updateQuantity(@item.MenuItemId, -1)">−</button>
                                    <span id="qty-@item.MenuItemId" class="btn btn-outline-secondary btn-sm" style="width: 40px;">0</span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            onclick="updateQuantity(@item.MenuItemId, 1)"> + </button>
                                </div>

                                <button type="button" class="btn btn-primary btn-sm"
                                        onclick="addToCart(@item.MenuItemId)">
                                    Thêm
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script>

        function filterCategory(category, event) {
            const allItems = document.querySelectorAll('.menu-item');
            const buttons = document.querySelectorAll('.filter-container .btn-group button');

            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            allItems.forEach(item => {
                if (category === 'all' || item.dataset.category === category)
                    item.style.display = 'block';
                else
                    item.style.display = 'none';
            });
        }

        function updateQuantity(menuItemId, change) {
            const qtyElement = document.getElementById('qty-' + menuItemId);
            let currentQty = parseInt(qtyElement.textContent) || 0;
            qtyElement.textContent = Math.max(0, currentQty + change);
        }

        function addToCart(menuItemId) {
            const qtyElement = document.getElementById('qty-' + menuItemId);
            const quantity = parseInt(qtyElement.textContent) || 0;

            if (quantity <= 0) {
                alert('Vui lòng chọn số lượng trước.');
                return;
            }

            fetch('@Url.Action("AddToCart")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: `menuItemId=${menuItemId}&quantity=${quantity}&tableId=@table?.TableId&branchId=@branch?.BranchId`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    qtyElement.textContent = '0';
                    updateCartCount();
                } else {
                    alert(data.message || 'Không thể thêm vào giỏ hàng.');
                }
            });
        }

        function updateCartCount() {
            // Logic này có thể cần phức tạp hơn, ví dụ: lấy số lượng từ session/local storage
            // Hiện tại, nó chỉ đếm số lần nhấn "Thêm"
            const cartCount = document.getElementById('cart-count');
            const current = parseInt(cartCount.textContent) || 0;
            cartCount.textContent = current + 1;
        }
    </script>

</body>
</html>