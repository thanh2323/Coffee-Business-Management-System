@model IEnumerable<CoffeeShop.Domain.Entities.MenuItem>
@{
    Layout = null;
    ViewData["Title"] = "Menu";
    var table = ViewBag.Table as CoffeeShop.Domain.Entities.CafeTable;
    var branch = ViewBag.Branch as CoffeeShop.Domain.Entities.Branch;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@branch?.Name - Menu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #F5FAFF;
            font-family: 'Segoe UI', sans-serif;
            color: #333;
        }

        .menu-header {
            background-color: #ffffff;
            border-bottom: 1px solid #dce9ff;
            padding: 15px 20px;
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .menu-header h2 {
                font-weight: 700;
                color: #004aad;
                margin: 0;
            }

        .cart-btn {
            position: relative;
            font-weight: 500;
        }

        .hero {
            text-align: center;
            padding: 60px 20px 40px;
            background: linear-gradient(180deg, #EAF4FF 0%, #F5FAFF 100%);
        }

            .hero h1 {
                font-weight: 800;
                color: #003d99;
            }

            .hero p {
                color: #555;
                max-width: 650px;
                margin: 0 auto;
                font-size: 17px;
            }

        .section-title {
            font-weight: 700;
            color: #004aad;
            margin-top: 40px;
            margin-bottom: 20px;
            text-transform: uppercase;
            border-left: 5px solid #007bff;
            padding-left: 10px;
        }

        .card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 3px 8px rgba(0,0,0,0.08);
            background-color: #fff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .card:hover {
                transform: translateY(-4px);
                box-shadow: 0 6px 14px rgba(0,0,0,0.12);
            }

            .card img {
                width: 100%;
                height: 220px;
                object-fit: cover;
            }

        .card-body {
            padding: 15px;
        }

        .btn-group .btn {
            min-width: 35px;
        }

        footer {
            text-align: center;
            margin-top: 50px;
            padding: 20px 0;
            color: #666;
            font-size: 14px;
        }

        /* Category + Search on same row */
        .menu-toolbar {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .category-filter button {
            border-radius: 20px;
        }

        .search-bar {
            position: relative;
            width: 280px;
        }

            .search-bar input {
                width: 100%;
                border: 1px solid #cde3ff;
                border-radius: 25px;
                padding: 10px 40px 10px 15px;
                outline: none;
                transition: 0.2s;
                background-color: #fff;
            }

                .search-bar input:focus {
                    box-shadow: 0 0 8px rgba(0, 123, 255, 0.2);
                    border-color: #007bff;
                }

            .search-bar i {
                position: absolute;
                right: 15px;
                top: 10px;
                color: #007bff;
                font-size: 18px;
            }
    </style>
</head>

<body>

    <!-- Header -->
    <div class="menu-header">
        <h2>@branch?.Name - Bàn @table?.TableNumber</h2>
        <a href="#" class="btn btn-primary cart-btn">
            <i class="bi bi-cart3"></i> Giỏ hàng
            <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                0
            </span>
        </a>
    </div>

    <!-- Hero Section -->
    <div class="hero">
        <h1>Chào mừng đến với @branch?.Name ☕</h1>
        <p>
            Thưởng thức hương vị cà phê đậm đà và không gian thư giãn nhẹ nhàng.
            Chúng tôi mang đến cho bạn trải nghiệm tuyệt vời với đồ uống tươi mát mỗi ngày.
        </p>
    </div>

    <div class="container">

        <!-- Best Seller -->
        <h4 class="section-title">Best Seller</h4>
        <div class="row g-3">
            @{
                var bestSeller = new[]
                {
                        new { Name = "Cà phê đen", Price = 15000, Img="/images/coffee_black.jpg" },
                        new { Name = "Bạc xỉu", Price = 30000, Img="/images/bacxiu.jpg" },
                        new { Name = "Orange Americano", Price = 45000, Img="/images/orange_americano.jpg" }
                        };
            }
            @foreach (var item in bestSeller)
            {
                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <img src="@item.Img" alt="@item.Name" onerror="this.src='/images/no-image.png';" />
                        <div class="card-body">
                            <h6 class="card-title">@item.Name</h6>
                            <p class="text-muted mb-2">@item.Price.ToString("N0") ₫</p>
                            <button class="btn btn-sm btn-primary w-100">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- New Items -->
        <h4 class="section-title">Món mới</h4>
        <div class="row g-3">
            @{
                var newItems = new[]
                {
                        new { Name = "Mocha", Price = 42000, Img="/images/mocha.jpg" },
                        new { Name = "Matcha Latte", Price = 48000, Img="/images/matcha_latte.jpg" },
                        new { Name = "Cold Brew", Price = 50000, Img="/images/coldbrew.jpg" }
                        };
            }
            @foreach (var item in newItems)
            {
                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <img src="@item.Img" alt="@item.Name" onerror="this.src='/images/no-image.png';" />
                        <div class="card-body">
                            <h6 class="card-title">@item.Name</h6>
                            <p class="text-muted mb-2">@item.Price.ToString("N0") ₫</p>
                            <button class="btn btn-sm btn-success w-100">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Menu -->
        <h4 class="section-title">Thực đơn</h4>

        <div class="menu-toolbar">
            <div class="category-filter btn-group flex-wrap">
                <button class="btn btn-outline-primary active" onclick="filterCategory('all', event)">Tất cả</button>
                @foreach (var cat in Model.Select(m => m.Category).Distinct())
                {
                    <button class="btn btn-outline-primary" onclick="filterCategory('@cat', event)">@cat</button>
                }
            </div>

            <div class="search-bar">
                <input type="text" id="searchInput" placeholder="Tìm món..." onkeyup="searchMenu()">
                <i class="bi bi-search"></i>
            </div>
        </div>

        <div class="row g-3" id="menu-list">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-4 menu-item" data-category="@item.Category" data-name="@item.Name.ToLower()">
                    <div class="card h-100">
                        <img src="@Url.Content(item.ImagePath)" alt="@item.Name" onerror="this.src='/images/no-image.png';" />
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="card-title">@item.Name</h6>
                                <p class="text-muted mb-2">@item.Price.ToString("N0") ₫</p>
                                <span class="badge bg-secondary">@item.Category</span>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm mt-2">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <footer>© 2025 @branch?.Name Coffee | Cảm ơn bạn đã ghé thăm ☕</footer>

    <script>
        function filterCategory(category, event) {
            const allItems = document.querySelectorAll('.menu-item');
            const buttons = document.querySelectorAll('.category-filter .btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            allItems.forEach(item => {
                if (category === 'all' || item.dataset.category === category)
                    item.style.display = 'block';
                else
                    item.style.display = 'none';
            });
        }

        function searchMenu() {
            const input = document.getElementById("searchInput").value.toLowerCase();
            const items = document.querySelectorAll(".menu-item");
            items.forEach(item => {
                const name = item.dataset.name;
                item.style.display = name.includes(input) ? "block" : "none";
            });
        }
    </script>

</body>
</html>
