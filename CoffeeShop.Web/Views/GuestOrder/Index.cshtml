@model IEnumerable<CoffeeShop.Domain.Entities.MenuItem>
@{
    Layout = null;
    ViewData["Title"] = "Thực đơn";

    var table = ViewBag.Table as CoffeeShop.Domain.Entities.CafeTable;
    var branch = ViewBag.Branch as CoffeeShop.Domain.Entities.Branch;

    var allItems = Model.ToList();
    var bestSeller = allItems.Take(4).ToList();
    var newItems = allItems.TakeLast(4).ToList();
    var categories = allItems.Select(m => m.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

    <style>

        body {
            background: #e8f5ff;
            font-family: 'Segoe UI', sans-serif;
        }

        /* HEADER */
        .menu-header {
            background: white;
            border-bottom: 1px solid #cce5f7;
            padding: 18px 22px;
        }

            .menu-header h2 {
                font-weight: 700;
                font-size: 22px;
                color: #154c74;
            }

        /* INTRO */
        .branch-intro {
            text-align: left;
            padding: 35px 20px 10px 20px;
        }

            .branch-intro h1 {
                font-size: 42px;
                font-weight: 900;
                color: #0d304a; /* xanh đậm gần như đen */
                margin-bottom: 14px;
            }

            .branch-intro .slogan {
                font-size: 15px;
                line-height: 1.6;
                color: #4f6775;
                max-width: 780px;
                margin: 0 0 22px 0; /* Căn TRÁI hoàn toàn */
                text-align: left;
            }


            .branch-intro .info {
                font-size: 17px;
                color: #334b5a;
                line-height: 1.9;
            }

        .info i {
            margin-right: 6px;
        }

        /* SECTION TITLE */
        .section-title {
            font-size: 23px;
            font-weight: 700;
            color: #154c74;
            margin: 28px 0 14px;
        }

        /* FILTER SEARCH */
        .filter-search-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 4px;
            margin-bottom: 18px;
        }

        .category-buttons .btn {
            border-radius: 20px;
            border-color: #8fd1ff;
            color: #154c74;
            font-size: 15px;
            padding: 6px 14px;
        }

            .category-buttons .btn.active,
            .category-buttons .btn:hover {
                background: #8fd1ff;
                color: #083a59;
            }

        /* SEARCH */
        .search-wrapper {
            position: relative;
        }

            .search-wrapper i {
                position: absolute;
                top: 50%;
                left: 10px;
                transform: translateY(-50%);
                color: #7aa7c7;
            }

            .search-wrapper input {
                width: 190px;
                padding-left: 32px;
                border-radius: 14px;
                border: 1px solid #8fd1ff;
                padding-top: 6px;
                padding-bottom: 6px;
            }

        /* CARD */
        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 3px 8px rgba(0,0,0,0.10);
            background: white;
            transition: .2s;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 16px rgba(0,0,0,0.16);
            }

        .placeholder-img {
            height: 170px;
            background: #dff1ff;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #7aa7c7;
            font-size: 22px;
        }

        .card h6 {
            font-size: 18px;
            font-weight: 700;
            color: #000;
        }

        .price-label {
            color: #666;
            font-size: 17px;
            font-weight: 600;
        }

        /* PRICE + QTY */
        .price-qty-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
        }

        .qty-box {
            display: flex;
            gap: 6px;
            align-items: center;
        }

            .qty-box button {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                padding: 0;
            }

            .qty-box span {
                width: 40px;
                border-radius: 8px;
                text-align: center;
                padding: 3px 0;
                background: #f3faff;
                border: 1px solid #8fd1ff;
            }

        .btn-add {
            width: 100%;
            border-radius: 12px;
            background: #38a4e0;
            border: none;
            padding: 8px 0;
            font-weight: 600;
            margin-top: 10px;
        }

            .btn-add:hover {
                background: #1f8ac6;
            }

        /* FIXED ITEMS */
        .fixed-item {
            display: block !important;
        }

    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="menu-header d-flex justify-content-between align-items-center">
        <h2>@branch?.Name — Bàn @table?.TableNumber</h2>

        <a href="@Url.Action("Cart", new { tableId = table?.TableId, branchId = branch?.BranchId })"
           class="btn btn-primary position-relative">
            <i class="fas fa-shopping-cart me-1"></i>
            Giỏ hàng
            <span id="cart-count" class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill">0</span>
        </a>
    </div>

    <!-- INTRO -->
    <div class="container">
        <div class="branch-intro">

            <h1>@branch?.Name</h1>

            <div class="slogan">
                “Không chỉ là quán cà phê, chúng tôi mong muốn trở thành nơi kết nối cảm xúc,
                tạo ra những khoảnh khắc đẹp trong ngày của bạn. Mỗi món nước, mỗi món ăn
                đều được chuẩn bị với sự tỉ mỉ, chất lượng và trái tim của người làm nghề.”
            </div>

            <div class="info">
                <div><i class="fas fa-map-pin" style="color:#ff4d6d;"></i>@branch?.Address</div>
                <div><i class="fas fa-clock" style="color:#7a90a4;"></i>7:00 – 22:00 mỗi ngày</div>
                <div><i class="fas fa-phone-alt" style="color:#ff2f5e;"></i>Hotline: 0123 456 789</div>
            </div>

        </div>
    </div>


    <div class="container py-3">

        <!-- BEST SELLER -->
        <div class="section-title">🔥 Best Seller</div>

        <div class="row g-3">
            @foreach (var item in bestSeller)
            {
                <div class="col-6 col-md-4 col-lg-3 fixed-item">

                    <div class="card h-100">

                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@Url.Content(item.ImagePath)" class="card-img-top">
                        }
                        else
                        {

                            <div class="placeholder-img">IMG</div>
                        }

                        <div class="card-body d-flex flex-column text-center">

                            <h6>@item.Name</h6>

                            <div class="price-qty-row">
                                <span class="price-label">@item.Price.ToString("N0") ₫</span>

                                <div class="qty-box">
                                    <button onclick="updateQuantity(@item.MenuItemId, -1)" class="btn btn-outline-secondary btn-sm">−</button>
                                    <span id="qty-@item.MenuItemId">0</span>
                                    <button onclick="updateQuantity(@item.MenuItemId, 1)" class="btn btn-outline-secondary btn-sm">+</button>
                                </div>
                            </div>

                            <button class="btn btn-primary btn-add" onclick="addToCart(@item.MenuItemId)">Thêm</button>

                        </div>
                    </div>

                </div>
            }
        </div>


        <!-- NEW ITEMS -->
        <div class="section-title mt-4">🆕 Món mới</div>

        <div class="row g-3">
            @foreach (var item in newItems)
            {
                <div class="col-6 col-md-4 col-lg-3 fixed-item">

                    <div class="card h-100">

                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@Url.Content(item.ImagePath)" class="card-img-top">
                        }
                        else
                        {

                            <div class="placeholder-img">IMG</div>
                        }

                        <div class="card-body d-flex flex-column text-center">

                            <h6>@item.Name</h6>

                            <div class="price-qty-row">
                                <span class="price-label">@item.Price.ToString("N0") ₫</span>

                                <div class="qty-box">
                                    <button onclick="updateQuantity(@item.MenuItemId, -1)" class="btn btn-outline-secondary btn-sm">−</button>
                                    <span id="qty-@item.MenuItemId">0</span>
                                    <button onclick="updateQuantity(@item.MenuItemId, 1)" class="btn btn-outline-secondary btn-sm">+</button>
                                </div>
                            </div>

                            <button class="btn btn-primary btn-add" onclick="addToCart(@item.MenuItemId)">Thêm</button>

                        </div>
                    </div>

                </div>
            }
        </div>


        <!-- ALL ITEMS -->
        <div class="section-title mt-4">📋 Tất cả món</div>

        <!-- FILTER + SEARCH -->
        <div class="filter-search-row">

            <div class="category-buttons d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-primary active"
                        onclick="filterCategory('all', event)">
                    Tất cả
                </button>

                @foreach (var cat in categories)
                {
                    <button class="btn btn-outline-primary"
                            onclick="filterCategory('@cat', event)">
                        @cat
                    </button>
                }
            </div>

            <div class="search-wrapper">
                <i class="fas fa-search"></i>
                <input id="searchInput" placeholder="Tìm..." onkeyup="searchMenu()">
            </div>

        </div>


        <div class="row g-3">
            @foreach (var item in allItems)
            {
                <div class="col-6 col-md-4 col-lg-3 menu-item"
                     data-category="@item.Category"
                     data-name="@item.Name.ToLower()">

                    <div class="card h-100">

                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@Url.Content(item.ImagePath)" class="card-img-top">
                        }
                        else
                        {

                            <div class="placeholder-img">IMG</div>
                        }

                        <div class="card-body d-flex flex-column text-center">

                            <h6>@item.Name</h6>

                            <div class="price-qty-row">
                                <span class="price-label">@item.Price.ToString("N0") ₫</span>

                                <div class="qty-box">
                                    <button onclick="updateQuantity(@item.MenuItemId, -1)" class="btn btn-outline-secondary btn-sm">−</button>
                                    <span id="qty-@item.MenuItemId">0</span>
                                    <button onclick="updateQuantity(@item.MenuItemId, 1)" class="btn btn-outline-secondary btn-sm">+</button>
                                </div>
                            </div>

                            <button class="btn btn-primary btn-add"
                                    onclick="addToCart(@item.MenuItemId)">
                                Thêm
                            </button>
                        </div>

                    </div>

                </div>
            }
        </div>

    </div>


    <script>
        function filterCategory(category, event) {

            document.querySelectorAll(".category-buttons .btn")
                .forEach(b => b.classList.remove("active"));
            event.target.classList.add("active");

            // Chỉ lọc ALL ITEMS
            document.querySelectorAll(".menu-item").forEach(item => {
                item.style.display =
                    (category === "all" || item.dataset.category === category)
                    ? "block"
                    : "none";
            });
        }

        function searchMenu() {
            let text = document.getElementById("searchInput").value.toLowerCase();

            document.querySelectorAll(".menu-item").forEach(item => {
                item.style.display =
                    item.dataset.name.includes(text) ? "block" : "none";
            });
        }

        function updateQuantity(id, change) {
            const el = document.getElementById("qty-" + id);
            let value = parseInt(el.textContent);
            el.textContent = Math.max(0, value + change);
        }

        function addToCart(id) {
            const qty = parseInt(document.getElementById("qty-" + id).textContent);
            if (qty <= 0) return alert("Vui lòng chọn số lượng.");

            fetch('@Url.Action("AddToCart")', {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `menuItemId=${id}&quantity=${qty}&tableId=@table?.TableId&branchId=@branch?.BranchId`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    document.getElementById("qty-" + id).textContent = 0;
                    updateCartCount();
                }
            });
        }

        function updateCartCount() {
            let badge = document.getElementById("cart-count");
            badge.textContent = (parseInt(badge.textContent) || 0) + 1;
        }
    </script>

</body>
</html>
