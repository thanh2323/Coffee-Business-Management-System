@model CoffeeShop.Domain.Entities.Branch
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Edit Branch";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="mb-1">Edit Branch</h2>
			<p class="text-muted mb-0">
				Business: <strong>@(ViewBag.BusinessName ?? "-")</strong> | Owner: <strong>@(ViewBag.OwnerName ?? "-")</strong>
			</p>
		</div>
	</div>

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<div class="mb-4">
						<h4 class="card-title mb-2">
							<i class="fas fa-store text-primary me-2"></i>@Model.Name
						</h4>
						<p class="text-muted small mb-0">Update branch information and settings.</p>
					</div>

					<form method="post">
						<input type="hidden" name="id" value="@Model.BranchId" />
						
						<div class="row">
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold" for="name">
									<i class="fas fa-store me-2 text-primary"></i> Branch Name <span class="text-danger">*</span>
								</label>
								<input class="form-control form-control-lg" type="text" id="name" name="name" value="@Model.Name" required />
								<small class="form-text text-muted">Choose a clear, identifiable name for this location.</small>
							</div>
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold" for="address">
									<i class="fas fa-map-marker-alt me-2 text-primary"></i> Address
								</label>
								<input class="form-control form-control-lg" type="text" id="address" name="address" value="@Model.Address" />
								<small class="form-text text-muted">Full address of the branch location.</small>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold" for="openTime">
									<i class="fas fa-door-open me-2 text-success"></i> Opening Time <span class="text-danger">*</span>
								</label>
								<input class="form-control form-control-lg" type="time" id="openTime" name="openTime" value="@Model.OpenTime.ToString(@"hh\:mm")" required />
								<small class="form-text text-muted">Daily opening time.</small>
							</div>
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold" for="closeTime">
									<i class="fas fa-door-closed me-2 text-danger"></i> Closing Time <span class="text-danger">*</span>
								</label>
								<input class="form-control form-control-lg" type="time" id="closeTime" name="closeTime" value="@Model.CloseTime.ToString(@"hh\:mm")" required />
								<small class="form-text text-muted">Daily closing time.</small>
							</div>
						</div>

						<hr class="my-4 bg-light" />

						<div class="d-flex justify-content-between align-items-center">
							<div>
								<a class="btn btn-outline-secondary" asp-action="Index">
									<i class="fas fa-times me-2"></i> Cancel
								</a>
								<a class="btn btn-success ms-2" asp-controller="Tables" asp-action="Create" asp-route-branchId="@Model.BranchId">
									<i class="fas fa-plus me-2"></i> Add Table
								</a>
							</div>
							<button class="btn btn-primary btn-lg px-4" type="submit">
								<i class="fas fa-check me-2"></i> Save Changes
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>


