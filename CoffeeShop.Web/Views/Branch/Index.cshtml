@model IEnumerable<CoffeeShop.Domain.Entities.Branch>
@{
	Layout = "~/Views/Shared/_Layout2.cshtml";
	ViewData["Title"] = "Branches";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="mb-1">Your Branches</h2>
			<p class="text-muted mb-0">
				Business: <strong>@(ViewBag.BusinessName ?? "-")</strong> | Owner: <strong>@(ViewBag.OwnerName ?? "-")</strong>
			</p>
		</div>
		<a class="btn btn-primary" asp-action="Create">
			<i class="fas fa-plus me-1"></i> Add Branch
		</a>
	</div>

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["Success"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	@if (Model.Any())
	{
		<div class="row g-4">
			@foreach (var b in Model)
			{
				<div class="col-md-6 col-lg-4">
					<div class="card shadow-sm h-100 border-0">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-start mb-3">
								<div>
									<h5 class="card-title mb-1">
										<i class="fas fa-store text-primary me-2"></i>@b.Name
									</h5>
									<p class="text-muted small mb-0">
										<i class="fas fa-map-marker-alt me-1"></i>@(b.Address ?? "No address")
									</p>
								</div>
								<div class="dropdown">
									<button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
										<i class="fas fa-ellipsis-v"></i>
									</button>
									<ul class="dropdown-menu dropdown-menu-end">
										<li>
											<a class="dropdown-item" asp-action="Edit" asp-route-id="@b.BranchId">
												<i class="fas fa-edit me-2"></i> Edit Branch
											</a>
										</li>
										<li><hr class="dropdown-divider" /></li>
										<li>
											<form method="post" asp-action="Delete" asp-route-id="@b.BranchId" class="d-inline" onsubmit="return confirm('Delete this branch?');">
												<button class="dropdown-item text-danger" type="submit">
													<i class="fas fa-trash me-2"></i> Delete Branch
												</button>
											</form>
										</li>
									</ul>
								</div>
							</div>

							<div class="mb-3">
								<span class="badge bg-info">
									<i class="fas fa-clock me-1"></i>@b.OpenTime.ToString(@"hh\:mm") - @b.CloseTime.ToString(@"hh\:mm")
								</span>
							</div>

							<div class="row g-2 mb-3">
								<div class="col-6">
									<a asp-controller="MenuItems" asp-action="Index" asp-route-branchId="@b.BranchId" class="btn btn-outline-primary btn-sm w-100">
										<i class="fas fa-utensils me-1"></i> Menu
									</a>
								</div>
								<div class="col-6">
									<a asp-controller="Tables" asp-action="Index" asp-route-branchId="@b.BranchId" class="btn btn-outline-info btn-sm w-100">
										<i class="fas fa-table me-1"></i> Tables
									</a>
								</div>
								<div class="col-6">
									<a asp-controller="Ingredients" asp-action="Index" asp-route-branchId="@b.BranchId" class="btn btn-outline-secondary btn-sm w-100">
										<i class="fas fa-box me-1"></i> Ingredients
									</a>
								</div>
								<div class="col-6">
									<a asp-action="Edit" asp-route-id="@b.BranchId" class="btn btn-outline-success btn-sm w-100">
										<i class="fas fa-edit me-1"></i> Edit
									
									</a>
								</div>
							</div>

							<hr class="my-3" />

							<div class="d-flex justify-content-center align-items-center">
								<small class="text-muted">
									<i class="fas fa-calendar me-1"></i>@b.CreatedAt.ToString("MMM dd, yyyy")
								</small>
								<a asp-controller="ManageStaff" asp-action="Index" asp-route-branchId="@b.BranchId" class="btn btn-outline-success btn-sm w-100">
									<i class="fas fa-edit me-1"></i> Manage Staff

								</a>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
	else
	{
		<div class="card shadow-sm">
			<div class="card-body text-center py-5">
				<i class="fas fa-store fa-3x text-muted mb-3"></i>
				<h5>No branches yet</h5>
				<p class="text-muted mb-4">Get started by creating your first branch.</p>
				<a class="btn btn-primary" asp-action="Create">
					<i class="fas fa-plus me-1"></i> Create Your First Branch
				</a>
			</div>
		</div>
	}
</div>


