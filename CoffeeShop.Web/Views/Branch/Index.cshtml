@model IEnumerable<CoffeeShop.Domain.Entities.Branch>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Quản lý chi nhánh";
}

<style>
    /* Dropdown đơn giản (vẫn theo bố cục cũ) */
    .dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown-menu {
        display: none;
        position: absolute;
        right: 0;
        background: #fff;
        min-width: 180px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        border-radius: 6px;
        padding: 8px 0;
        z-index: 100;
    }

        .dropdown-menu a,
        .dropdown-menu form button {
            display: block;
            width: 100%;
            text-align: left;
            background: none;
            border: none;
            padding: 8px 16px;
            font-size: 14px;
            color: #333;
            text-decoration: none;
            cursor: pointer;
        }

            .dropdown-menu a:hover,
            .dropdown-menu form button:hover {
                background-color: #f5f5f5;
            }

    .dropdown.show .dropdown-menu {
        display: block;
    }

    .dropdown-divider {
        border-top: 1px solid #e5e5e5;
        margin: 6px 0;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Danh sách chi nhánh</h2>
            <p class="text-muted mb-0">
                Doanh nghiệp: <strong>@(ViewBag.BusinessName ?? "-")</strong> | Chủ sở hữu: <strong>@(ViewBag.OwnerName ?? "-")</strong>
            </p>
        </div>
        <a class="btn btn-primary" asp-action="Create">
            <i class="fas fa-plus me-1"></i> Thêm chi nhánh
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" aria-label="Đóng" onclick="this.parentElement.remove();"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" aria-label="Đóng" onclick="this.parentElement.remove();"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var b in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="fas fa-store text-primary me-2"></i>@b.Name
                                    </h5>
                                    <p class="text-muted small mb-0">
                                        <i class="fas fa-map-marker-alt me-1"></i>@(b.Address ?? "Chưa có địa chỉ")
                                    </p>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@b.BranchId">
                                                <i class="fas fa-edit me-2"></i> Chỉnh sửa
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form method="post" asp-action="Delete" asp-route-id="@b.BranchId"
                                                  class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa chi nhánh này không?');">
                                                <button class="dropdown-item text-danger" type="submit">
                                                    <i class="fas fa-trash me-2"></i> Xóa chi nhánh
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="mb-3">
                                <span class="badge bg-info">
                                    <i class="fas fa-clock me-1"></i>@b.OpenTime.ToString(@"hh\:mm") - @b.CloseTime.ToString(@"hh\:mm")
                                </span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <a asp-controller="MenuItems" asp-action="Index" asp-route-branchId="@b.BranchId" class="btn btn-outline-primary btn-sm w-100">
                                        <i class="fas fa-utensils me-1"></i> Menu
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a asp-controller="Tables" asp-action="Index" asp-route-branchId="@b.BranchId" class="btn btn-outline-info btn-sm w-100">
                                        <i class="fas fa-table me-1"></i> Bàn
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a asp-controller="Ingredients" asp-action="Index" asp-route-branchId="@b.BranchId" class="btn btn-outline-secondary btn-sm w-100">
                                        <i class="fas fa-box me-1"></i> Nguyên liệu
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a asp-controller="ManageStaff" asp-action="Index" asp-route-branchId="@b.BranchId" class="btn btn-outline-success btn-sm w-100">
                                        <i class="fas fa-users me-1"></i> Nhân viên
                                    </a>
                                </div>
                            </div>

                            <hr class="my-3" />

                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>Ngày tạo: @b.CreatedAt.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <i class="fas fa-store fa-4x text-muted mb-3"></i>
                <h5>Chưa có chi nhánh nào</h5>
                <p class="text-muted mb-4">Hãy bắt đầu bằng cách tạo chi nhánh đầu tiên của bạn.</p>
                <a class="btn btn-primary" asp-action="Create">
                    <i class="fas fa-plus me-1"></i> Tạo chi nhánh đầu tiên
                </a>
            </div>
        </div>
    }
</div>

<script>
    // Dropdown JS (nếu không dùng Bootstrap)
    document.addEventListener("click", function (e) {
        const btn = e.target.closest(".dropdown-toggle");
        document.querySelectorAll(".dropdown").forEach(d => {
            if (btn && d.contains(btn)) {
                d.classList.toggle("show");
            } else {
                d.classList.remove("show");
            }
        });
    });
</script>
