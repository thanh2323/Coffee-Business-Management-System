@{
	Layout = "~/Views/Shared/_Layout2.cshtml";
	ViewData["Title"] = "Thêm món mới";
	var branchId = ViewBag.BranchId as int?;
}

<div class="container mt-4">
	<div class="mb-4">
		<h2 class="mb-1">Thêm món mới</h2>
		<p class="text-muted mb-0">Tạo một món mới cho thực đơn của bạn</p>
	</div>

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@TempData["ErrorMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<div class="mb-4">
						<h4 class="card-title mb-2">
							<i class="fas fa-utensils text-primary me-2"></i>Thông tin món
						</h4>
						<p class="text-muted small mb-0">Nhập thông tin chi tiết cho món mới của bạn.</p>
					</div>

					<form method="post" asp-action="Create" enctype="multipart/form-data">
						<input type="hidden" name="branchId" value="@branchId" />

						<div class="row">
							<div class="col-md-12 mb-3">
								<label for="name" class="form-label fw-semibold">
									<i class="fas fa-tag me-2 text-primary"></i>Tên món <span class="text-danger">*</span>
								</label>
								<input type="text"
									   class="form-control form-control-lg"
									   id="name"
									   name="name"
									   required
									   maxlength="200"
									   placeholder="Ví dụ: Espresso, Cappuccino, Croissant">
								<small class="form-text text-muted">Chọn một tên rõ ràng, dễ mô tả cho món này.</small>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="price" class="form-label fw-semibold">
									<i class="fas fa-tags me-2 text-success"></i>Giá (VND) <span class="text-danger">*</span>
								</label>
								<div class="input-group input-group-lg">
									<input type="number"
										   class="form-control"
										   id="price"
										   name="price"
										   required
										   min="1000"
										   max="500000"
										   step="1000"
										   placeholder="Nhập giá">
									<span class="input-group-text">VND</span>
								</div>
								<small class="form-text text-muted">Giá phải từ 1.000 đến 500.000 VND</small>
							</div>
							<div class="col-md-6 mb-3">
								<label for="category" class="form-label fw-semibold">
									<i class="fas fa-folder me-2 text-info"></i>Danh mục
								</label>
								<input type="text"
									   class="form-control form-control-lg"
									   id="category"
									   name="category"
									   maxlength="100"
									   placeholder="Ví dụ: Cà phê, Trà, Bánh">
								<small class="form-text text-muted">Tùy chọn: Dùng để nhóm các món tương tự</small>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="imageFile" class="form-label fw-semibold">
									<i class="fas fa-image me-2 text-warning"></i>Hình ảnh sản phẩm
								</label>
								<input type="file" class="form-control form-control-lg" id="imageFile" name="imageFile" accept="image/*" />
								<small class="form-text text-muted">Tải lên hình ảnh (JPG, PNG, WEBP). Không bắt buộc nhưng nên có.</small>
							</div>
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold d-block mb-2">
									<i class="fas fa-toggle-on me-2 text-success"></i>Trạng thái
								</label>
								<div class="form-check form-switch mt-2">
									<input type="checkbox"
										   class="form-check-input"
										   id="isAvailable"
										   name="isAvailable"
										   value="true"
										   checked
										   style="width: 3em; height: 1.5em;">
									<label class="form-check-label ms-2" for="isAvailable">
										Có sẵn để đặt hàng
									</label>
								</div>
								<small class="form-text text-muted">Bỏ chọn nếu món này tạm thời không có sẵn</small>
							</div>
						</div>

						<hr class="my-4 bg-light" />

						<div class="d-flex justify-content-between align-items-center">
							<a href="@Url.Action("Index", new { branchId })" class="btn btn-outline-secondary">
								<i class="fas fa-times me-2"></i> Hủy
							</a>
							<button type="submit" class="btn btn-primary btn-lg px-4">
								<i class="fas fa-check me-2"></i> Tạo món
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>