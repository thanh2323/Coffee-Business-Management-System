@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Add Menu Item";
    var branchId = ViewBag.BranchId as int?;
}

<div class="container mt-4">
	<div class="mb-4">
		<h2 class="mb-1">Add New Menu Item</h2>
		<p class="text-muted mb-0">Create a new item for your menu</p>
	</div>

	@if (TempData["ErrorMessage"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@TempData["ErrorMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<div class="mb-4">
						<h4 class="card-title mb-2">
							<i class="fas fa-utensils text-primary me-2"></i>Menu Item Information
						</h4>
						<p class="text-muted small mb-0">Enter the details for your new menu item.</p>
					</div>

					<form method="post" asp-action="Create" enctype="multipart/form-data">
						<input type="hidden" name="branchId" value="@branchId" />
						
						<div class="row">
							<div class="col-md-12 mb-3">
								<label for="name" class="form-label fw-semibold">
									<i class="fas fa-tag me-2 text-primary"></i>Item Name <span class="text-danger">*</span>
								</label>
								<input type="text" 
									   class="form-control form-control-lg" 
									   id="name" 
									   name="name" 
									   required 
									   maxlength="200"
									   placeholder="e.g., Espresso, Cappuccino, Croissant">
								<small class="form-text text-muted">Choose a clear, descriptive name for this item.</small>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="price" class="form-label fw-semibold">
									<i class="fas fa-tags me-2 text-success"></i>Price (VND) <span class="text-danger">*</span>
								</label>
								<div class="input-group input-group-lg">
									<input type="number" 
										   class="form-control" 
										   id="price" 
										   name="price" 
										   required 
										   min="1000" 
										   max="500000" 
										   step="1000"
										   placeholder="Enter price">
									<span class="input-group-text">VND</span>
								</div>
								<small class="form-text text-muted">Price must be between 1,000 and 500,000 VND</small>
							</div>
							<div class="col-md-6 mb-3">
								<label for="category" class="form-label fw-semibold">
									<i class="fas fa-folder me-2 text-info"></i>Category
								</label>
								<input type="text" 
									   class="form-control form-control-lg" 
									   id="category" 
									   name="category" 
									   maxlength="100"
									   placeholder="e.g., Coffee, Tea, Pastry">
								<small class="form-text text-muted">Optional: Group similar items together</small>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6 mb-3">
								<label for="imageFile" class="form-label fw-semibold">
									<i class="fas fa-image me-2 text-warning"></i>Product Image
								</label>
								<input type="file" class="form-control form-control-lg" id="imageFile" name="imageFile" accept="image/*"/>
								<small class="form-text text-muted">Upload an image (JPG, PNG, WEBP). Optional but recommended.</small>
							</div>
							<div class="col-md-6 mb-3">
								<label class="form-label fw-semibold d-block mb-2">
									<i class="fas fa-toggle-on me-2 text-success"></i>Availability
								</label>
								<div class="form-check form-switch mt-2">
									<input type="checkbox" 
										   class="form-check-input" 
										   id="isAvailable" 
										   name="isAvailable" 
										   value="true" 
										   checked
										   style="width: 3em; height: 1.5em;">
									<label class="form-check-label ms-2" for="isAvailable">
										Available for ordering
									</label>
								</div>
								<small class="form-text text-muted">Uncheck if this item is temporarily unavailable</small>
							</div>
						</div>

						<hr class="my-4 bg-light" />

						<div class="d-flex justify-content-between align-items-center">
							<a href="@Url.Action("Index", new { branchId })" class="btn btn-outline-secondary">
								<i class="fas fa-times me-2"></i> Cancel
							</a>
							<button type="submit" class="btn btn-primary btn-lg px-4">
								<i class="fas fa-check me-2"></i> Create Menu Item
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

