@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Edit Ingredient in Recipe";
    var recipe = ViewBag.Recipe as CoffeeShop.Domain.Entities.MenuItemRecipe;
}

<div class="container mt-4">
	<div class="mb-4">
		<h2 class="mb-1">Edit Ingredient in Recipe</h2>
		<p class="text-muted mb-0">Update quantity for recipe ingredient</p>
	</div>

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="card shadow-sm border-0">
				<div class="card-body p-4">
					<div class="mb-4">
						<h4 class="card-title mb-2">
							<i class="fas fa-edit text-primary me-2"></i>Recipe Ingredient
						</h4>
						<p class="text-muted small mb-0">Update the quantity for this ingredient.</p>
					</div>

					<form method="post" action="@Url.Action("EditIngredient", new { menuItemId = ViewBag.MenuItemId, ingredientId = ViewBag.IngredientId })">
						<input type="hidden" name="BranchId" value="@ViewBag.BranchId" />

						<div class="mb-3">
							<label class="form-label fw-semibold">
								<i class="fas fa-leaf me-2 text-success"></i>Ingredient
							</label>
							<input type="text" class="form-control form-control-lg" value="@recipe?.Ingredient?.Name (@recipe?.Ingredient?.BaseUnit)" readonly>
							<small class="form-text text-muted">This ingredient cannot be changed. Edit quantity below.</small>
						</div>

						<div class="mb-3">
							<label for="quantity" class="form-label fw-semibold">
								<i class="fas fa-weight me-2 text-info"></i>Quantity <span class="text-danger">*</span>
							</label>
							<div class="input-group input-group-lg">
								<input type="number" class="form-control" id="quantity" name="quantity" 
									   step="1" min="0" value="@recipe?.Quantity" required>
								<span class="input-group-text">@recipe?.Ingredient?.BaseUnit</span>
							</div>
							<small class="form-text text-muted">Enter the amount needed for this recipe.</small>
						</div>

						<hr class="my-4 bg-light" />

						<div class="d-flex justify-content-between align-items-center">
							<a href="@Url.Action("Index", new { branchId = ViewBag.BranchId ,menuItemId = ViewBag.MenuItemId })"
							   class="btn btn-outline-secondary">
								<i class="fas fa-times me-2"></i> Cancel
							</a>
							<button type="submit" class="btn btn-primary btn-lg px-4">
								<i class="fas fa-check me-2"></i> Update Recipe
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>




